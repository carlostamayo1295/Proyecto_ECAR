<MudDialog Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Registro de Auditoría #@Registro?.IdAuditoria</MudText>
    </TitleContent>
    <DialogContent>
        @if (Registro != null)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption">Tabla</MudText>
                    <MudText Typo="Typo.body1">@Registro.Tabla</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption">ID del Registro Afectado</MudText>
                    <MudText Typo="Typo.body1">@Registro.RegistroId</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption">Acción</MudText>
                    <MudText Typo="Typo.body1">@Registro.Accion</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption">Usuario</MudText>
                    <MudText Typo="Typo.body1">@Registro.Usuario</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption">Fecha y Hora</MudText>
                    <MudText Typo="Typo.body1">@Registro.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudText>
                </MudItem>
            </MudGrid>

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Valor Anterior</MudText>
                    <MudPaper Elevation="0" Class="value-box pa-3">
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-word;">@(Registro.ValorAnterior ?? "-")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Valor Nuevo</MudText>
                    <MudPaper Elevation="0" Class="value-box pa-3">
                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-word;">@(Registro.ValorNuevo ?? "-")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close" Class="dialog-button">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public AuditoriaDto? Registro { get; set; }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}

<style>
.dialog-button {
    border-radius: 12px !important;
    min-width: 100px !important;
    font-weight: 500 !important;
}

.dialog-button.mud-button-filled {
    background-color: #397FDE !important;
    color: white !important;
}

.dialog-button.mud-button-filled:hover {
    background-color: #2A5FB8 !important;
}

.value-box {
    border: 1px solid #E0E6ED !important;
    border-radius: 8px !important;
    background-color: #F4F5F7 !important;
    min-height: 80px;
    max-height: 300px;
    overflow-y: auto;
}
</style>
