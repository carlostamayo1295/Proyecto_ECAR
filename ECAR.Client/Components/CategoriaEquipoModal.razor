@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Options="new DialogOptions { CloseOnEscapeKey = false }">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEditMode ? "Editar Categoría" : "Crear Nueva Categoría")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField T="string" Label="Nombre de la Categoría" @bind-Value="nombre"
                Variant="Variant.Outlined" Required="true" RequiredError="El nombre de la categoría es requerido"
                MaxLength="100" Immediate="true" Class="mb-3" />

            <MudTextField T="string" Label="Descripción" @bind-Value="descripcion"
                Variant="Variant.Outlined" MaxLength="500" Immediate="true"
                Lines="3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Class="dialog-button cancel-btn">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSubmit" Class="dialog-button">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm? form;
    private string nombre = string.Empty;
    private string? descripcion;

    [Parameter]
    public CategoriaEquipoDto? Categoria { get; set; }

    private bool IsEditMode => Categoria != null;

    protected override void OnInitialized()
    {
        if (IsEditMode && Categoria != null)
        {
            nombre = Categoria.Nombre;
            descripcion = Categoria.Descripcion;
        }
    }

    private async Task HandleSubmit()
    {
        if (form != null)
        {
            await form.ValidateAsync();
            if (!form.IsValid)
            {
                return;
            }
        }

        if (IsEditMode && Categoria != null)
        {
            var updateDto = new UpdateCategoriaEquipoDto { Nombre = nombre, Descripcion = descripcion };
            var result = await HttpClientService.UpdateCategoriaEquipoAsync(Categoria.IdCategoria, updateDto);

            if (result != null && result.Success)
            {
                Snackbar.Add("Categoría actualizada exitosamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Error al actualizar categoría", Severity.Error);
            }
        }
        else
        {
            var createDto = new CreateCategoriaEquipoDto { Nombre = nombre, Descripcion = descripcion };
            var result = await HttpClientService.CreateCategoriaEquipoAsync(createDto);

            if (result != null && result.Success)
            {
                Snackbar.Add("Categoría creada exitosamente", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Error al crear categoría", Severity.Error);
            }
        }
    }

    private async Task Cancel()
    {
        var parameters = new DialogParameters { ["Message"] = "¿Realmente desea cancelar?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar Cancelación", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            MudDialog.Cancel();
        }
    }
}

<style>
.dialog-button {
    border-radius: 12px !important;
    min-width: 100px !important;
    font-weight: 500 !important;
}

.dialog-button.mud-button-filled {
    background-color: #397FDE !important;
    color: white !important;
}

.dialog-button.mud-button-filled:hover {
    background-color: #2A5FB8 !important;
}

.cancel-btn {
    background-color: #79B75D !important;
    color: white !important;
}

.cancel-btn:hover {
    background-color: #68A552 !important;
}
</style>
