@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject HttpClientService HttpClientService

<MudDialog Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Código QR</MudText>
    </TitleContent>
    <DialogContent>
        <div class="qr-print-area">
            @if (cargando)
            {
                <div class="d-flex justify-center my-6">
                    <MudProgressCircular Indeterminate="true" />
                </div>
            }
            else if (qrDataUrl != null)
            {
                <MudImage Src="@qrDataUrl" Alt="Código QR del equipo" Width="250" Height="250"
                    ObjectFit="ObjectFit.Contain" Class="d-block mx-auto mb-3" />
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">No fue posible obtener el código QR.</MudAlert>
            }
            <MudText Align="Align.Center" Typo="Typo.subtitle1" Class="font-weight-bold">
                @CodigoInterno
            </MudText>
            <MudText Align="Align.Center" Typo="Typo.body2" Class="mud-text-secondary">
                @NombreEquipo
            </MudText>
        </div>

        @if (esTokenNuevo)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                Se generó un código QR nuevo para este equipo. Imprima y pegue la etiqueta.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cerrar">Cerrar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
            StartIcon="@Icons.Material.Filled.Print" OnClick="Imprimir">
            Imprimir etiqueta
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(qrDataUrl == null)"
            StartIcon="@Icons.Material.Filled.Download" Href="@qrDataUrl" Target="_blank"
            download="@($"QR-{CodigoInterno}.png")">
            Descargar PNG
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
            StartIcon="@Icons.Material.Filled.Refresh" OnClick="Regenerar">
            Regenerar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public long IdEquipo { get; set; }
    [Parameter] public string CodigoInterno { get; set; } = string.Empty;
    [Parameter] public string NombreEquipo { get; set; } = string.Empty;

    private bool cargando = true;
    private bool esTokenNuevo;
    // La imagen viene del API como bytes y se muestra como data URI (el endpoint exige token Bearer)
    private string? qrDataUrl;

    protected override async Task OnInitializedAsync()
    {
        // POST es idempotente: si el equipo ya tiene QR devuelve el existente
        var result = await HttpClientService.GenerateEquipoQrAsync(IdEquipo);
        if (result == null || !result.Success || result.Data == null)
        {
            Snackbar.Add(result?.Message ?? "Error al generar el código QR", Severity.Error);
            cargando = false;
            return;
        }

        esTokenNuevo = result.Data.EsNuevo;
        await CargarImagenAsync();
    }

    private async Task CargarImagenAsync()
    {
        cargando = true;
        qrDataUrl = await HttpClientService.GetEquipoQrImageDataUrlAsync(IdEquipo);
        if (qrDataUrl == null)
        {
            Snackbar.Add("No fue posible descargar la imagen del código QR", Severity.Error);
        }
        cargando = false;
    }

    private void Cerrar()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task Regenerar()
    {
        var parameters = new DialogParameters
        {
            ["Message"] = "Regenerar el QR invalida las etiquetas ya impresas y pegadas en este equipo. ¿Desea continuar?"
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar regeneración", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var regenerado = await HttpClientService.RegenerateEquipoQrAsync(IdEquipo);
            if (regenerado == null || !regenerado.Success)
            {
                Snackbar.Add(regenerado?.Message ?? "Error al regenerar el código QR", Severity.Error);
                return;
            }

            esTokenNuevo = true;
            Snackbar.Add(regenerado.Message ?? "Código QR regenerado", Severity.Success);
            await CargarImagenAsync();
        }
    }
}
