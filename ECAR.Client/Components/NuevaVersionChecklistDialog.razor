@inject ISnackbar Snackbar
@inject HttpClientService HttpClientService

<MudDialog Options="new DialogOptions { CloseOnEscapeKey = false }">
    <TitleContent>
        <MudText Typo="Typo.h6">Nueva Versión del Checklist</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Se creará una nueva versión de "@Checklist?.Nombre" copiando sus preguntas actuales. La versión "@Checklist?.Version" quedará inactiva.
        </MudText>
        <MudForm @ref="form">
            <MudTextField T="string" Label="Número de Versión" @bind-Value="nuevaVersion"
                Variant="Variant.Outlined" Required="true" RequiredError="La versión es requerida"
                MaxLength="20" Immediate="true" HelperText="Ej: v2, 2.0, 2024-02" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Class="dialog-button cancel-btn">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSubmit" Disabled="@guardando" Class="dialog-button">Crear Versión</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm? form;
    private string nuevaVersion = string.Empty;
    private bool guardando;

    [Parameter]
    public ChecklistDto? Checklist { get; set; }

    private async Task HandleSubmit()
    {
        if (form != null)
        {
            await form.ValidateAsync();
            if (!form.IsValid)
            {
                return;
            }
        }

        if (Checklist != null && string.Equals(Checklist.Version, nuevaVersion, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("La nueva versión debe ser diferente de la actual", Severity.Warning);
            return;
        }

        if (Checklist == null)
        {
            return;
        }

        guardando = true;
        var result = await HttpClientService.CreateChecklistVersionAsync(
            Checklist.IdChecklist, new CreateChecklistVersionDto { Version = nuevaVersion.Trim() });
        guardando = false;

        if (result != null && result.Success)
        {
            Snackbar.Add(result.Message ?? $"Versión '{nuevaVersion}' creada exitosamente", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(result?.Message ?? "Error al crear la versión", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}

<style>
.dialog-button {
    border-radius: 12px !important;
    min-width: 100px !important;
    font-weight: 500 !important;
}

.dialog-button.mud-button-filled {
    background-color: #397FDE !important;
    color: white !important;
}

.dialog-button.mud-button-filled:hover {
    background-color: #2A5FB8 !important;
}

.cancel-btn {
    background-color: #79B75D !important;
    color: white !important;
}

.cancel-btn:hover {
    background-color: #68A552 !important;
}
</style>
