@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* PASO 2 — Evidencias fotográficas. Dueño: FE-2 (Santiago). *@

<MudText Typo="Typo.subtitle1" Class="mb-2">Evidencias fotográficas</MudText>

@if (!Inspeccion.EstaCerrada)
{
    <MudFileUpload T="IBrowserFile" @ref="fileUpload" Accept="image/*" capture="environment"
        Disabled="Subiendo" FilesChanged="OnArchivoSeleccionadoAsync">
        <CustomContent Context="fileUploadContext">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Subiendo"
                StartIcon="@Icons.Material.Filled.AddAPhoto" OnClick="@fileUploadContext.OpenFilePickerAsync">
                Agregar fotografía
            </MudButton>
        </CustomContent>
        <SelectedTemplate Context="_"></SelectedTemplate>
    </MudFileUpload>

    @if (Subiendo)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Subiendo @_subidasEnCurso fotografía(s)…
        </MudText>
    }
}

<MudText Typo="Typo.body2" Class="mud-text-secondary mt-3 mb-2">
    @Inspeccion.Evidencias.Count fotografía(s) adjunta(s)
</MudText>

@if (Inspeccion.Evidencias.Any())
{
    <MudGrid>
        @foreach (var evidencia in Inspeccion.Evidencias)
        {
            <MudItem xs="6" sm="4" md="3">
                <MudCard Outlined="true">
                    @if (miniaturas.TryGetValue(evidencia.IdEvidencia, out var src) && src != null)
                    {
                        <MudImage Src="@src" ObjectFit="ObjectFit.Cover" Height="140" Width="200" Class="mud-width-full" />
                    }
                    else
                    {
                        <MudSkeleton Height="140px" />
                    }
                    <MudCardContent Class="pa-2">
                        <MudText Typo="Typo.caption" Class="text-truncate d-block">@evidencia.NombreOriginal</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@FormatearTamano(evidencia.TamanoBytes)</MudText>
                    </MudCardContent>
                    @if (!Inspeccion.EstaCerrada)
                    {
                        <MudCardActions Class="pa-2 pt-0">
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                StartIcon="@Icons.Material.Filled.Delete" OnClick="() => ConfirmarEliminarAsync(evidencia)">
                                Eliminar
                            </MudButton>
                        </MudCardActions>
                    }
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter, EditorRequired]
    public InspeccionEjecucionDto Inspeccion { get; set; } = null!;

    /// <summary>Avisa a la página contenedora para que refresque el resumen del paso.</summary>
    [Parameter]
    public EventCallback OnEvidenciasCambiadas { get; set; }

    private MudFileUpload<IBrowserFile>? fileUpload;

    /// <summary>Caché de miniaturas ya descargadas, por IdEvidencia, para no repetir la llamada al API en cada render.</summary>
    private readonly Dictionary<long, string?> miniaturas = new();

    // Nº de fotografías subiéndose ahora mismo. Se usa para el indicador de progreso, nunca
    // para descartar una subida: tirar una foto en silencio perdería evidencia de la
    // inspección sin que el técnico se entere.
    private int _subidasEnCurso;

    /// <summary>true mientras haya alguna fotografía subiéndose. Úsalo para la barra de progreso.</summary>
    protected bool Subiendo => _subidasEnCurso > 0;

    protected override async Task OnParametersSetAsync()
    {
        await CargarMiniaturasFaltantesAsync();
    }

    /// <summary>Comprime la fotografía tomada/elegida y la sube; limpia el control para el siguiente disparo.</summary>
    private async Task OnArchivoSeleccionadoAsync(IBrowserFile archivo)
    {
        if (archivo == null)
        {
            return;
        }

        IBrowserFile archivoComprimido;
        try
        {
            // La red de planta no aguanta fotos de varios MB directo de la cámara: se reduce antes de subir.
            archivoComprimido = await archivo.RequestImageFileAsync("image/jpeg", 1600, 1600);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo procesar la fotografía seleccionada", Severity.Error);
            return;
        }

        await SubirAsync(archivoComprimido);
        await CargarMiniaturasFaltantesAsync();

        if (fileUpload != null)
        {
            await fileUpload.ClearAsync();
        }
    }

    /// <summary>Sube una fotografía y la añade a la lista en memoria.</summary>
    protected async Task SubirAsync(IBrowserFile archivo)
    {
        if (archivo.Size > HttpClientService.MaxEvidenciaBytes)
        {
            Snackbar.Add("La fotografía supera el máximo de 5 MB", Severity.Warning);
            return;
        }

        _subidasEnCurso++;
        await InvokeAsync(StateHasChanged);

        var result = await HttpClientService.UploadEvidenciaAsync(Inspeccion.IdInspeccion, archivo);

        _subidasEnCurso--;
        await InvokeAsync(StateHasChanged);

        if (result == null || !result.Success || result.Data == null)
        {
            Snackbar.Add(result?.Message ?? "Error al subir la fotografía", Severity.Error);
            return;
        }

        Inspeccion.Evidencias.Add(result.Data);
        Snackbar.Add("Fotografía cargada", Severity.Success);
        await OnEvidenciasCambiadas.InvokeAsync();
    }

    /// <summary>Pide confirmación antes de borrar, siguiendo el criterio visual de la Fase 2.</summary>
    private async Task ConfirmarEliminarAsync(EvidenciaDto evidencia)
    {
        var parameters = new DialogParameters { ["Message"] = $"¿Está seguro que desea eliminar la fotografía \"{evidencia.NombreOriginal}\"?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar Eliminación", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await EliminarAsync(evidencia);
        }
    }

    /// <summary>Elimina una evidencia (solo mientras la inspección siga en curso).</summary>
    protected async Task EliminarAsync(EvidenciaDto evidencia)
    {
        var result = await HttpClientService.DeleteEvidenciaAsync(evidencia.IdEvidencia);

        if (result == null || !result.Success)
        {
            Snackbar.Add(result?.Message ?? "Error al eliminar la fotografía", Severity.Error);
            return;
        }

        Inspeccion.Evidencias.Remove(evidencia);
        miniaturas.Remove(evidencia.IdEvidencia);
        await OnEvidenciasCambiadas.InvokeAsync();
    }

    /// <summary>Imagen lista para el atributo Src de MudImage; null si no se pudo descargar.</summary>
    protected Task<string?> CargarMiniaturaAsync(EvidenciaDto evidencia) =>
        HttpClientService.GetEvidenciaImageDataUrlAsync(evidencia.IdEvidencia, evidencia.TipoContenido);

    private async Task CargarMiniaturasFaltantesAsync()
    {
        var faltantes = Inspeccion.Evidencias.Where(e => !miniaturas.ContainsKey(e.IdEvidencia)).ToList();

        foreach (var evidencia in faltantes)
        {
            miniaturas[evidencia.IdEvidencia] = await CargarMiniaturaAsync(evidencia);
        }
    }

    private static string FormatearTamano(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / (1024.0 * 1024.0):0.0} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024.0:0} KB";
        }

        return $"{bytes} B";
    }
}
