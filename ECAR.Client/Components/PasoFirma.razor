@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar

<MudCard Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" Class="mb-3">Resumen antes de firmar</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.body2"><b>Equipo:</b> @Inspeccion.NombreEquipo</MudText>
            <MudText Typo="Typo.body2"><b>Checklist:</b> @Inspeccion.NombreChecklist (v. @Inspeccion.VersionChecklist)</MudText>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.body2"><b>Preguntas:</b> @Inspeccion.Preguntas.Count respuesta(s)</MudText>
            <MudText Typo="Typo.body2"><b>Novedades:</b> @Inspeccion.TotalNovedades novedad(es)</MudText>
            <MudText Typo="Typo.body2"><b>Evidencias:</b> @Inspeccion.Evidencias.Count fotografía(s)</MudText>
        </MudItem>
    </MudGrid>
</MudCard>

<MudAlert Severity="Severity.Warning" Class="mb-4 text-justify">
    @TextoLegal
</MudAlert>

<div class="d-flex justify-center mb-2">
    <FirmaCanvas OnFirmaConfirmada="ProcesarFirmaCanvas" />
</div>

@code {
    [Parameter, EditorRequired]
    public InspeccionEjecucionDto Inspeccion { get; set; } = null!;

    /// <summary>Se dispara con el resultado cuando la inspección queda firmada y cerrada.</summary>
    [Parameter]
    public EventCallback<InspeccionResultadoDto> OnFirmada { get; set; }

    /// <summary>Devuelve al paso de preguntas cuando el API reporta obligatorias faltantes.</summary>
    [Parameter]
    public EventCallback OnVolverAPreguntas { get; set; }

    protected const string TextoLegal =
        "Al firmar, declaro que realicé esta inspección y que la información registrada es veraz. " +
        "La inspección quedará cerrada y no podrá modificarse.";

    private bool firmando;

    private async Task ProcesarFirmaCanvas(string firmaBase64)
    {
        await FirmarAsync(firmaBase64);
    }
    /// <summary>
    /// Firma y cierra la inspección. Recibe el PNG tal como lo produce el canvas (con o sin
    /// el prefijo data:), porque el API solo acepta el base64 pelado.
    /// </summary>
    protected async Task FirmarAsync(string firmaPng, string? observaciones = null)
    {
        if (firmando || string.IsNullOrWhiteSpace(firmaPng))
        {
            Snackbar.Add("Debe dibujar la firma antes de cerrar la inspección", Severity.Warning);
            return;
        }

        firmando = true;
        var result = await HttpClientService.FirmarInspeccionAsync(Inspeccion.IdInspeccion, new FirmarInspeccionDto
        {
            FirmaPngBase64 = QuitarPrefijoDataUri(firmaPng),
            Observaciones = observaciones
        });
        firmando = false;

        if (result == null || !result.Success || result.Data == null)
        {
            Snackbar.Add(result?.Message ?? "Error al firmar la inspección", Severity.Error);

            // El API detalla en Errors las preguntas obligatorias que faltan por responder.
            if (result?.Errors is { Count: > 0 })
            {
                foreach (var error in result.Errors)
                {
                    Snackbar.Add(error, Severity.Warning);
                }
                await OnVolverAPreguntas.InvokeAsync();
            }
            return;
        }

        Snackbar.Add(result.Message ?? "Inspección firmada y cerrada", Severity.Success);
        await OnFirmada.InvokeAsync(result.Data);
    }

    private static string QuitarPrefijoDataUri(string firmaPng)
    {
        var separador = firmaPng.IndexOf("base64,", StringComparison.OrdinalIgnoreCase);
        return separador >= 0 ? firmaPng[(separador + "base64,".Length)..] : firmaPng;
    }
}
