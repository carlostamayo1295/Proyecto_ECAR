@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar

@* PASO 1 — Preguntas y respuestas.  Dueño: FE-1 (Erica).

   Qué falta implementar (docs/PLAN_FASE3_TAREAS.md §5, FE-1):
   1. Recorrer Inspeccion.Preguntas en orden y pintar cada una con RespuestaPreguntaInput
      (ya existe: SiNo = dos casillas, Texto = campo de texto).
   2. Marcar visualmente las obligatorias y mostrar el campo Observación; hacerlo obligatorio
      cuando la pregunta sea Sí/No respondida con "No" (regla 4 del SRS).
   3. Guardado incremental: llamar a GuardarAsync con debounce de 500 ms al cambiar una
      respuesta, y mostrar el indicador "Guardando / Guardado / Error al guardar".

   Lo que ya está resuelto aquí: el contrato con la página contenedora, la llamada al API y
   el indicador de guardado. No hace falta tocar EjecutarInspeccion.razor.

   IMPORTANTE al pintar el campo Observación: hay que persistirlo igual que la respuesta.
   Una novedad sin observación no deja cerrar la inspección (regla 4 del SRS), así que el
   campo debe llamar a GuardarAsync al cambiar, no solo enlazar con @@bind-Value. *@

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
    Paso pendiente de implementar (FE-1). El contrato con el API ya está disponible.
</MudAlert>

@* Indicador de guardado. La guía §5 pide los tres estados, no solo "Guardando…". *@
@if (Estado != EstadoGuardado.Inactivo)
{
    <MudText Typo="Typo.caption" Class="d-block mb-2" Color="@ColorEstado">
        @TextoEstado
    </MudText>
}

@if (Inspeccion.Preguntas.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true">
        Este checklist no tiene preguntas configuradas.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @Inspeccion.Preguntas.Count pregunta(s) · @Inspeccion.TotalObligatorias obligatoria(s)
    </MudText>
}

@code {
    [Parameter, EditorRequired]
    public InspeccionEjecucionDto Inspeccion { get; set; } = null!;

    /// <summary>Avisa a la página contenedora para que refresque los contadores del paso.</summary>
    [Parameter]
    public EventCallback OnRespuestasGuardadas { get; set; }

    protected enum EstadoGuardado { Inactivo, Guardando, Guardado, Error }

    /// <summary>Estado del último guardado; lo pinta el indicador de la cabecera.</summary>
    protected EstadoGuardado Estado { get; private set; } = EstadoGuardado.Inactivo;

    // Contador de peticiones en vuelo. No se usa para descartar guardados: solo para saber
    // si queda alguno pendiente antes de mostrar "Guardado".
    private int _guardadosEnCurso;

    private string TextoEstado => Estado switch
    {
        EstadoGuardado.Guardando => "Guardando…",
        EstadoGuardado.Guardado => "Guardado",
        EstadoGuardado.Error => "Error al guardar",
        _ => string.Empty
    };

    private Color ColorEstado => Estado switch
    {
        EstadoGuardado.Error => Color.Error,
        EstadoGuardado.Guardado => Color.Success,
        _ => Color.Default
    };

    /// <summary>
    /// Envía un lote de respuestas y refleja lo guardado en la copia en memoria.
    /// Se puede llamar con una sola respuesta (guardado incremental) o con todas.
    /// Se invoca desde tareas lanzadas fuera del ciclo de render (debounce), por eso el
    /// repintado va siempre por InvokeAsync.
    /// </summary>
    protected async Task GuardarAsync(IEnumerable<RespuestaEjecucionDto> respuestas)
    {
        var lote = respuestas.ToList();
        if (lote.Count == 0)
        {
            return;
        }

        // Nunca se descarta un guardado porque haya otro en vuelo: el upsert del API es
        // idempotente por (IdInspeccion, IdPregunta), así que dos envíos no se pisan, y
        // tirar uno en silencio perdería la respuesta del técnico sin avisar.
        _guardadosEnCurso++;
        await CambiarEstadoAsync(EstadoGuardado.Guardando);

        var result = await HttpClientService.GuardarRespuestasAsync(
            Inspeccion.IdInspeccion, new GuardarRespuestasDto { Respuestas = lote });

        _guardadosEnCurso--;

        if (result == null || !result.Success || result.Data == null)
        {
            await CambiarEstadoAsync(EstadoGuardado.Error);
            Snackbar.Add(result?.Message ?? "Error al guardar las respuestas", Severity.Error);
            return;
        }

        // Actualización en sitio: no se reemplaza la colección para no pisar lo que el
        // técnico esté escribiendo en otra pregunta.
        foreach (var guardada in lote)
        {
            var pregunta = Inspeccion.Preguntas.FirstOrDefault(p => p.IdPregunta == guardada.IdPregunta);
            var confirmada = result.Data.Preguntas.FirstOrDefault(p => p.IdPregunta == guardada.IdPregunta);
            if (pregunta != null && confirmada != null)
            {
                pregunta.IdRespuesta = confirmada.IdRespuesta;
                pregunta.Respuesta = confirmada.Respuesta;
                pregunta.Observacion = confirmada.Observacion;
            }
        }

        // Los contadores sí son escalares: la fuente de verdad es el servidor.
        Inspeccion.TotalObligatorias = result.Data.TotalObligatorias;
        Inspeccion.ObligatoriasRespondidas = result.Data.ObligatoriasRespondidas;
        Inspeccion.TotalNovedades = result.Data.TotalNovedades;

        // Solo se anuncia "Guardado" cuando no queda ningún envío pendiente.
        if (_guardadosEnCurso == 0)
        {
            await CambiarEstadoAsync(EstadoGuardado.Guardado);
        }

        await OnRespuestasGuardadas.InvokeAsync();
    }

    /// <summary>
    /// Cambia el estado y repinta. Va por InvokeAsync porque GuardarAsync se llama desde
    /// tareas lanzadas fuera del ciclo de render: sin esto el indicador no se actualiza.
    /// </summary>
    private async Task CambiarEstadoAsync(EstadoGuardado nuevo)
    {
        Estado = nuevo;
        await InvokeAsync(StateHasChanged);
    }
}
