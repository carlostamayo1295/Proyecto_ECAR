@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* Muestra una sola vez la contraseña temporal que generó el servidor al restablecerla (Fase 4,
   Parte 11 §11.300). No se puede cerrar por error: ni con Escape ni haciendo clic fuera, porque
   después de cerrar ya no hay forma de verla.

   Uso:
       await PasswordTemporalDialog.MostrarAsync(DialogService, usuario.Nombre, temporal.PasswordTemporal);
*@

<MudDialog Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false }">
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Contraseña temporal para <b>@Usuario</b>. Entréguesela por un canal seguro: el usuario deberá cambiarla al iniciar sesión.
        </MudText>

        <MudTextField T="string" Value="@PasswordTemporal" ReadOnly="true" Variant="Variant.Outlined"
                      Label="Contraseña temporal" Class="mb-3"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="CopiarAsync" AdornmentAriaLabel="Copiar contraseña"
                      Style="font-family: monospace;" />

        <MudAlert Severity="Severity.Warning" Dense="true">
            Esta contraseña se muestra una sola vez. Si la pierde, tendrá que restablecerla de nuevo.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy"
                   OnClick="CopiarAsync">Copiar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cerrar">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public string Usuario { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PasswordTemporal { get; set; } = string.Empty;

    private async Task CopiarAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", PasswordTemporal);
            Snackbar.Add("Contraseña copiada", Severity.Success);
        }
        catch (JSException)
        {
            // Sin permiso del navegador para el portapapeles: se puede seleccionar el texto a mano.
            Snackbar.Add("No se pudo copiar. Selecciónela y cópiela manualmente.", Severity.Warning);
        }
    }

    private void Cerrar() => MudDialog.Close();

    public static Task MostrarAsync(IDialogService dialogos, string usuario, string passwordTemporal)
    {
        var parametros = new DialogParameters<PasswordTemporalDialog>
        {
            { d => d.Usuario, usuario },
            { d => d.PasswordTemporal, passwordTemporal }
        };

        return dialogos.ShowAsync<PasswordTemporalDialog>("Contraseña temporal", parametros);
    }
}
