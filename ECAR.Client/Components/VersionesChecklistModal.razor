@inject IDialogService DialogService
@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar

<MudDialog Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">Versiones de "@Checklist?.Nombre"</MudText>
    </TitleContent>
    <DialogContent>
        @if (cargando)
        {
            <MudProgressLinear Indeterminate="true" Class="my-4" />
        }
        else if (versiones.Any())
        {
            <MudTable Items="versiones" Hover="true" Striped="true" Elevation="0" Dense="true">
                <HeaderContent>
                    <MudTh>Versión</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Preguntas</MudTh>
                    <MudTh>Fecha Creación</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>
                <RowTemplate Context="version">
                    <MudTd>@version.Version</MudTd>
                    <MudTd>
                        <MudChip T="string" Color="@(version.Activo ? Color.Success : Color.Default)"
                            Size="Size.Small" Variant="Variant.Outlined" Text="@(version.Activo ? "Activa" : "Histórica")" />
                    </MudTd>
                    <MudTd>
                        @version.TotalPreguntas
                        @if (version.TieneRespuestas)
                        {
                            <MudTooltip Text="Ya se usó en inspecciones: sus preguntas no se pueden modificar">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="ml-1" />
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd>@version.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                            StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => VerVersion(version)" Class="action-button">
                            Ver
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info">No hay versiones para mostrar</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close" Class="dialog-button">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ChecklistDto? Checklist { get; set; }

    private List<ChecklistVersionDto> versiones = new();
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        if (Checklist == null)
        {
            cargando = false;
            return;
        }

        var result = await HttpClientService.GetChecklistVersionesAsync(Checklist.IdChecklist);
        if (result != null && result.Success && result.Data != null)
        {
            versiones = result.Data;
        }
        else
        {
            Snackbar.Add(result?.Message ?? "Error al cargar las versiones", Severity.Error);
        }
        cargando = false;
    }

    // El detalle necesita las preguntas: se pide la versión completa al API
    private async Task VerVersion(ChecklistVersionDto version)
    {
        var result = await HttpClientService.GetChecklistAsync(version.IdChecklist);
        if (result == null || !result.Success || result.Data == null)
        {
            Snackbar.Add(result?.Message ?? "Error al cargar el checklist", Severity.Error);
            return;
        }

        var parameters = new DialogParameters { ["Checklist"] = result.Data };
        await DialogService.ShowAsync<ChecklistDetailModal>("Detalle del Checklist", parameters);
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}

<style>
.dialog-button {
    border-radius: 12px !important;
    min-width: 100px !important;
    font-weight: 500 !important;
}

.dialog-button.mud-button-filled {
    background-color: #397FDE !important;
    color: white !important;
}

.dialog-button.mud-button-filled:hover {
    background-color: #2A5FB8 !important;
}

.action-button {
    border-radius: 8px !important;
    font-weight: 500 !important;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2) !important;
    transition: all 0.2s ease !important;
}

.action-button:hover {
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3) !important;
    transform: translateY(-1px) !important;
}
</style>
