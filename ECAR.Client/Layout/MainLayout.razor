@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthorizationService AuthorizationService
@inject AuthService AuthService
@inject HttpClientService HttpClientService

@using MudBlazor

<MudLayout>
    <MudThemeProvider Theme="temaEcar" />
    <MudDialogProvider />
    <MudPopoverProvider />
    <MudSnackbarProvider />
    <VigilanteSesion />

    @* En el login no hay barra ni menú: su tarjeta ya lleva el logo (Fase 5, F-05). *@
    @if (!EsLogin)
    {
    <MudAppBar Elevation="3" Class="app-bar">
        @if (isAuthenticated)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" title="Menú" />
        }
        <MudSpacer />
        <img src="images/logo-ecar.png" alt="ECAR Logo" class="app-bar-logo" />
        <MudSpacer />
        @* En el teléfono los botones quedan solo con el icono: con el texto, la barra medía más
           de 375 px y ensanchaba todas las páginas. *@
        @if (isAuthenticated)
        {
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="HandleLogout" title="Cerrar sesión">
                <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                <span class="texto-barra">Logout</span>
            </MudButton>
        }
    </MudAppBar>
    }

    @* Sin sesión no hay menú: el login y la consulta del QR no deben mostrar el resto del sistema.
       El cajón se monta siempre (así abre como antes en escritorio) y solo se cierra sin sesión.
       MudNavLink resalta la página en la que se está; «Administración» es un grupo que se despliega,
       no una opción que parezca seleccionada (Fase 5, F-04). *@
    <MudDrawer @bind-Open="drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Class="sidebar">
        @if (isAuthenticated && !EsLogin)
        {
        <MudNavMenu Class="menu-lateral">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/inspecciones" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment">Inspecciones</MudNavLink>
            @* Consulta de equipos para todos los roles; crear y editar sigue siendo del Administrador. *@
            <MudNavLink Href="/equipos" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Devices">Equipos</MudNavLink>
            <MudNavLink Href="/evidencias" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PhotoLibrary">Evidencias</MudNavLink>
            @* El Operador no resuelve novedades: las de sus inspecciones las ve en el resultado de cada una. *@
            @if (!soloOperador)
            {
                <MudNavLink Href="/novedades" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReportProblem">Novedades</MudNavLink>
            }
            @* Exacto: «Preguntas de Checklist» está en /checklists/preguntas y con Prefix se resaltarían las dos. *@
            <MudNavLink Href="/checklists" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PlaylistAddCheck">Checklists</MudNavLink>
            @if (!soloOperador)
            {
                <MudNavLink Href="/categorias-equipo" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Category">Categoría de Equipos</MudNavLink>
            }
            @* Reportes y auditoría: solo Administrador y Supervisor, igual que el API. *@
            @if (isAdmin || isSupervisor)
            {
                <MudNavLink Href="/auditoria" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.History">Auditoría</MudNavLink>
                <MudNavLink Href="/reportes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Summarize">Reportes</MudNavLink>
            }

            @if (isAdmin)
            {
                <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.AdminPanelSettings" @bind-Expanded="administracionAbierta">
                    <MudNavLink Href="/ubicaciones" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Place">Ubicaciones</MudNavLink>
                    <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Usuarios</MudNavLink>
                    <MudNavLink Href="/admin/roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AssignmentInd">Roles</MudNavLink>
                    <MudNavLink Href="/admin/usuarios-roles" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Roles de Usuario</MudNavLink>
                    <MudNavLink Href="/checklists/preguntas" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FactCheck">Preguntas de Checklist</MudNavLink>
                </MudNavGroup>
            }
        </MudNavMenu>
        }
    </MudDrawer>

    <MudMainContent Class="@(EsLogin ? "main-content sin-barra" : "main-content")">
        <MudContainer MaxWidth="MaxWidth.Large" Class="content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
.app-bar {
    background-color: #397FDE !important;
}

.app-bar-logo {
    max-height: 40px;
    width: auto;
    object-fit: contain;
}

.sidebar {
    background-color: #2A5FB8 !important;
    /* El menú no se desplaza a lo ancho: antes medía 238 px en un cajón de 230 y salía una barra horizontal. */
    overflow-x: hidden !important;
}

.main-content {
    background-color: #F4F5F7;
    min-height: 100vh;
}

/* Sin barra (login) el contenido no necesita el espacio que MudBlazor reserva arriba para ella. */
.main-content.sin-barra {
    padding-top: 0 !important;
}

/* El login mide la altura de la pantalla: con el relleno del contenedor sobraban 64 px y se desplazaba. */
.main-content.sin-barra .content {
    padding: 0;
}

.content {
    padding: 2rem;
}

.menu-lateral {
    padding-block: 8px;
}

/* Texto e íconos blancos sobre el azul del cajón; MudBlazor los pinta con el color primario al activarse. */
.sidebar .menu-lateral .mud-nav-link {
    color: #FFFFFF !important;
    border-radius: 8px;
    margin: 2px 8px;
    width: auto;
    transition: background-color 0.2s ease;
}

.sidebar .menu-lateral .mud-nav-link .mud-nav-link-icon,
.sidebar .menu-lateral .mud-nav-link .mud-nav-link-expand-icon {
    color: #FFFFFF !important;
}

.sidebar .menu-lateral .mud-nav-link:hover:not(.mud-nav-link-disabled) {
    background-color: rgba(255, 255, 255, 0.12) !important;
}

/* La página actual: fondo más claro y una marca a la izquierda. */
.sidebar .menu-lateral .mud-nav-link.active:not(.mud-nav-link-disabled) {
    background-color: rgba(255, 255, 255, 0.22) !important;
    box-shadow: inset 4px 0 0 #FFFFFF;
    font-weight: 600;
}

/* «Administración» es un encabezado: separado del resto y sin fondo propio. */
.sidebar .menu-lateral .mud-nav-group {
    margin-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 6px;
}

.sidebar .menu-lateral .mud-nav-group > .mud-nav-link {
    font-weight: 600;
}

/* Teléfono (por debajo de 600 px, donde MudBlazor apila las tablas). */
@@media (max-width: 599.98px) {
    .texto-barra {
        display: none;
    }

    .app-bar .mr-2 {
        margin-right: 0 !important;
    }

    .content {
        padding: 1rem 0.5rem;
    }

    /* El botón "Nuevo …" de la cabecera de cada tarjeta baja de línea en vez de salirse. */
    .mud-card-header {
        flex-wrap: wrap;
    }

    .mud-card-header .mud-card-header-actions {
        margin-top: 0.5rem;
    }
}
</style>

@code {
    // El primario de MudBlazor es el azul de ECAR: con el morado por defecto salían en morado los campos
    // enfocados, los interruptores activos y los botones Outlined y Text (Fase 5, F-01).
    private static readonly MudTheme temaEcar = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#397FDE",
            PrimaryDarken = "#2A5FB8",
            PrimaryLighten = "#6BA0E6",
            AppbarBackground = "#397FDE"
        }
    };

    private bool drawerOpen = true;
    private bool administracionAbierta = true;

    // El layout se vuelve a pintar en cada navegación (cambia Body), así que basta con leer la ruta aquí.
    private bool EsLogin =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0]
            .Equals("login", StringComparison.OrdinalIgnoreCase);
    private bool isAdmin = false;
    private bool isSupervisor = false;
    private bool soloOperador = false;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticated();
        drawerOpen = isAuthenticated;
        if (isAuthenticated)
        {
            var roles = await AuthorizationService.GetUserRolesAsync();
            isAdmin = roles.Contains(RolesSistema.Administrador);
            isSupervisor = roles.Contains(RolesSistema.Supervisor);
            soloOperador = roles.Contains(RolesSistema.Operador) && !isAdmin && !isSupervisor
                           && !roles.Contains(RolesSistema.Estandar);
        }
    }

    private void ToggleDrawer()
    {
        drawerOpen = !drawerOpen;
    }

    private async Task HandleLogout()
    {
        await HttpClientService.CerrarSesionAsync();
        await AuthService.ClearTokenAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
