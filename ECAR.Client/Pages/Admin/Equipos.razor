@page "/equipos"
@page "/admin/equipos"
@inject HttpClientService HttpClientService
@inject AuthorizationService AuthorizationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Inventario de equipos. El SRS (§4) da "consulta de equipos" al Auditor y el Técnico necesita la
   ficha para inspeccionar, así que la pantalla es de lectura para los tres roles; crear, editar,
   generar QR y desactivar siguen siendo solo del Administrador (regla 8), en el API y aquí.
   /admin/equipos se conserva para no romper enlaces guardados. *@
<RolRouteGuard Roles="@(new[] { "Administrador", "Técnico", "Auditor" })"
               MensajeNoAutorizado="Solo administradores, técnicos y auditores pueden consultar los equipos.">
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">@(esAdmin ? "Gestión de Equipos" : "Equipos")</MudText>
                <MudText Typo="Typo.body2">@(esAdmin ? "Administrar el inventario de equipos del sistema" : "Consulta del inventario, ficha técnica e historial de inspecciones")</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                @if (esAdmin)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                        Nuevo Equipo
                    </MudButton>
                }
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            @* Filtros del SRS §6: planta, área y criticidad (más la búsqueda libre). *@
            <MudGrid Class="mb-2">
                <MudItem xs="12" lg="4">
                    <MudTextField T="string" Label="Buscar" @bind-Value="searchText" Variant="Variant.Outlined"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                        OnKeyUp="OnSearchKeyUp" />
                </MudItem>
                <MudItem xs="12" sm="4" lg="2">
                    <MudSelect T="string" Label="Planta" Value="plantaFilter" ValueChanged="OnPlantaChanged"
                        Variant="Variant.Outlined" Clearable="true">
                        @foreach (var planta in Plantas)
                        {
                            <MudSelectItem T="string" Value="@planta">@planta</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" lg="2">
                    <MudSelect T="string" Label="Área" @bind-Value="areaFilter" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var area in Areas)
                        {
                            <MudSelectItem T="string" Value="@area">@area</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" lg="2">
                    <MudSelect T="string" Label="Criticidad" @bind-Value="criticidadFilter" Variant="Variant.Outlined"
                        Clearable="true">
                        <MudSelectItem T="string" Value="@("Alta")">Alta</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Media")">Media</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Baja")">Baja</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" lg="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                        StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="ApplyFilters">Filtrar</MudButton>
                </MudItem>
            </MudGrid>

            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (equipos != null && equipos.Any())
            {
                <MudTable Items="equipos" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Código Interno</MudTh>
                        <MudTh>Activo Fijo</MudTh>
                        <MudTh>Nombre</MudTh>
                        <MudTh>Categoría</MudTh>
                        <MudTh>Ubicación</MudTh>
                        <MudTh>Criticidad</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.IdEquipo.ToString()</MudTd>
                        <MudTd DataLabel="Código Interno">@context.CodigoInterno</MudTd>
                        <MudTd DataLabel="Activo Fijo">@context.ActivoFijo</MudTd>
                        <MudTd DataLabel="Nombre">@context.NombreEquipo</MudTd>
                        <MudTd DataLabel="Categoría">@(context.CategoriaNombre ?? "-")</MudTd>
                        <MudTd DataLabel="Ubicación">@(context.UbicacionNombre ?? "-")</MudTd>
                        <MudTd DataLabel="Criticidad">
                            @if (!string.IsNullOrEmpty(context.Criticidad))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@GetCriticidadColor(context.Criticidad)" Text="@context.Criticidad" />
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">-</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            <MudChip T="string" Color="@(context.Activo ? Color.Success : Color.Error)"
                                Size="Size.Small" Variant="Variant.Outlined" Text="@(context.Activo ? "Activo" : "Inactivo")" />
                        </MudTd>
                        <MudTd DataLabel="Acciones" Class="acciones-equipo">
                            <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Description" OnClick="() => OpenFichaDialog(context)" Class="action-button">
                                Ficha
                            </MudButton>
                            @if (esAdmin)
                            {
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                    StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialog(context)" Class="action-button">
                                    Editar
                                </MudButton>
                                <MudButton Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.QrCode" OnClick="() => OpenQrDialog(context)" Class="action-button">
                                    QR
                                </MudButton>
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteEquipo(context)" Class="action-button">
                                    @(context.Activo ? "Desactivar" : "Activar")
                                </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudPagination Class="mt-4" Count="@totalPages" Selected="@currentPage"
                    SelectedChanged="HandlePageChange" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    No hay equipos para mostrar
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
    </MudContainer>
</RolRouteGuard>

@code {
    private List<EquipoDto>? equipos;
    private List<LookupDto>? categorias;
    private List<LookupDto>? ubicaciones;
    private List<UbicacionDto> ubicacionesFiltro = new();
    private string searchText = string.Empty;
    private string? criticidadFilter;
    private string? plantaFilter;
    private string? areaFilter;
    private bool esAdmin;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private bool isLoading = false;

    private IEnumerable<string> Plantas => ubicacionesFiltro
        .Select(u => u.Planta).Distinct().OrderBy(p => p);

    // Las áreas se limitan a la planta elegida, si hay una.
    private IEnumerable<string> Areas => ubicacionesFiltro
        .Where(u => plantaFilter == null || u.Planta == plantaFilter)
        .Select(u => u.Area).Distinct().OrderBy(a => a);

    protected override async Task OnInitializedAsync()
    {
        esAdmin = await AuthorizationService.IsAdminAsync();
        await LoadLookupsAsync();
        await LoadDataAsync();
    }

    private void OnPlantaChanged(string? planta)
    {
        plantaFilter = planta;
        if (areaFilter != null && !Areas.Contains(areaFilter))
        {
            areaFilter = null;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ApplyFilters();
        }
    }

    private async Task OpenFichaDialog(EquipoDto equipo)
    {
        var parameters = new DialogParameters { ["Equipo"] = equipo };
        await DialogService.ShowAsync<EquipoFichaModal>("Ficha técnica", parameters);
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var catResult = await HttpClientService.GetEquipoCategoriasLookupAsync();
            categorias = catResult?.Success == true ? catResult.Data ?? new() : new();

            var ubResult = await HttpClientService.GetEquipoUbicacionesLookupAsync();
            ubicaciones = ubResult?.Success == true ? ubResult.Data ?? new() : new();

            // Planta y área por separado para los filtros (el lookup las trae unidas en un texto).
            var ubicacionesResult = await HttpClientService.GetUbicacionesAsync(1, 100);
            ubicacionesFiltro = ubicacionesResult?.Success == true ? ubicacionesResult.Data?.Data ?? new() : new();
        }
        catch
        {
            categorias = new();
            ubicaciones = new();
            ubicacionesFiltro = new();
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;

        try
        {
            var result = await HttpClientService.GetEquiposAsync(currentPage, pageSize, searchText, criticidadFilter,
                planta: plantaFilter, area: areaFilter);

            if (result != null && result.Success && result.Data != null)
            {
                equipos = result.Data.Data ?? new List<EquipoDto>();
                totalPages = result.Data.TotalPages;
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Error al cargar equipos", Severity.Error);
                equipos = new List<EquipoDto>();
                totalPages = 1;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            equipos = new List<EquipoDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadDataAsync();
    }

    private static Color GetCriticidadColor(string? criticidad) => criticidad switch
    {
        "Alta" => Color.Error,
        "Media" => Color.Warning,
        "Baja" => Color.Success,
        _ => Color.Default
    };

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["Categorias"] = categorias,
            ["Ubicaciones"] = ubicaciones
        };
        var dialog = await DialogService.ShowAsync<EquipoModal>("Crear Nuevo Equipo", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialog(EquipoDto equipo)
    {
        var parameters = new DialogParameters
        {
            ["Equipo"] = equipo,
            ["Categorias"] = categorias,
            ["Ubicaciones"] = ubicaciones
        };
        var dialog = await DialogService.ShowAsync<EquipoModal>("Editar Equipo", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenQrDialog(EquipoDto equipo)
    {
        var parameters = new DialogParameters
        {
            ["IdEquipo"] = equipo.IdEquipo,
            ["CodigoInterno"] = equipo.CodigoInterno,
            ["NombreEquipo"] = equipo.NombreEquipo
        };
        var dialog = await DialogService.ShowAsync<EquipoQrModal>("Codigo QR del Equipo", parameters);
        await dialog.Result;
    }

    private async Task DeleteEquipo(EquipoDto equipo)
    {
        var action = equipo.Activo ? "desactivar" : "activar";
        var parameters = new DialogParameters { ["Message"] = $"¿Está seguro que desea {action} el equipo '{equipo.NombreEquipo}'?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>($"Confirmar {action}", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            isLoading = true;
            try
            {
                if (equipo.Activo)
                {
                    var deleteResult = await HttpClientService.DeleteEquipoAsync(equipo.IdEquipo);
                    if (deleteResult != null && deleteResult.Success)
                    {
                        Snackbar.Add("Equipo desactivado exitosamente", Severity.Success);
                        await LoadDataAsync();
                    }
                    else
                    {
                        Snackbar.Add(deleteResult?.Message ?? "Error al desactivar equipo", Severity.Error);
                    }
                }
                else
                {
                    var updateResult = await HttpClientService.ActivarEquipoAsync(equipo.IdEquipo);
                    if (updateResult != null && updateResult.Success)
                    {
                        Snackbar.Add("Equipo activado exitosamente", Severity.Success);
                        await LoadDataAsync();
                    }
                    else
                    {
                        Snackbar.Add(updateResult?.Message ?? "Error al activar equipo", Severity.Error);
                    }
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
    }
}

<style>
.action-button {
    border-radius: 8px !important;
    font-weight: 500 !important;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2) !important;
    transition: all 0.2s ease !important;
}

.action-button:hover {
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3) !important;
    transform: translateY(-1px) !important;
}

/* En el teléfono la tabla se apila: que los botones bajen de línea en vez de ensanchar la página. */
@@media (max-width: 599.98px) {
    .acciones-equipo {
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 4px;
    }
}
</style>
