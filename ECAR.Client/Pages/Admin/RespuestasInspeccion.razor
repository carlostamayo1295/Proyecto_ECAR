@page "/inspecciones/respuestas"
@inject MockDataService MockDataService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Respuestas de Inspección</MudText>
                <MudText Typo="Typo.body2">Respuestas registradas durante una inspección</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    Nueva Respuesta
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <MudTextField T="string" Label="Buscar" @bind-Value="searchText" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                Class="mb-4" />

            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (respuestas != null && respuestas.Any())
            {
                <MudTable Items="respuestas" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Inspección</MudTh>
                        <MudTh>Pregunta</MudTh>
                        <MudTh>Respuesta</MudTh>
                        <MudTh>Observación</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.IdRespuesta.ToString()</MudTd>
                        <MudTd>@context.IdInspeccion.ToString()</MudTd>
                        <MudTd>@context.IdPregunta.ToString()</MudTd>
                        <MudTd>@context.Respuesta</MudTd>
                        <MudTd>
                            @if (!string.IsNullOrWhiteSpace(context.Observacion))
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">@context.Observacion</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">Sin novedad</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialog(context)" Class="action-button">
                                Editar
                            </MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteRespuesta(context)" Class="action-button">
                                Eliminar
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudPagination Class="mt-4" Count="@totalPages" Selected="@currentPage"
                    SelectedPageChanged="HandlePageChange" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    No hay respuestas para mostrar
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<RespuestaInspeccionDto>? respuestas;
    private string searchText = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRespuestasAsync();
    }

    private async Task LoadRespuestasAsync()
    {
        isLoading = true;

        try
        {
            var result = await MockDataService.GetRespuestasInspeccionAsync(currentPage, pageSize, searchText);

            if (result != null && result.Success && result.Data != null)
            {
                respuestas = result.Data.Data ?? new List<RespuestaInspeccionDto>();
                totalPages = result.Data.TotalPages;
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Error al cargar respuestas", Severity.Error);
                respuestas = new List<RespuestaInspeccionDto>();
                totalPages = 1;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            respuestas = new List<RespuestaInspeccionDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadRespuestasAsync();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<RespuestaInspeccionModal>("Crear Nueva Respuesta");
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadRespuestasAsync();
        }
    }

    private async Task OpenEditDialog(RespuestaInspeccionDto respuesta)
    {
        var parameters = new DialogParameters { ["Respuesta"] = respuesta };
        var dialog = await DialogService.ShowAsync<RespuestaInspeccionModal>("Editar Respuesta", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadRespuestasAsync();
        }
    }

    private async Task DeleteRespuesta(RespuestaInspeccionDto respuesta)
    {
        var parameters = new DialogParameters { ["Message"] = $"¿Está seguro que desea eliminar la respuesta #{respuesta.IdRespuesta}?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar Eliminación", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            isLoading = true;
            try
            {
                var deleteResult = await MockDataService.DeleteRespuestaInspeccionAsync(respuesta.IdRespuesta);

                if (deleteResult != null && deleteResult.Success)
                {
                    Snackbar.Add("Respuesta eliminada exitosamente", Severity.Success);
                    await LoadRespuestasAsync();
                }
                else
                {
                    Snackbar.Add(deleteResult?.Message ?? "Error al eliminar respuesta", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
    }
}

<style>
.action-button {
    border-radius: 8px !important;
    font-weight: 500 !important;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2) !important;
    transition: all 0.2s ease !important;
}

.action-button:hover {
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3) !important;
    transform: translateY(-1px) !important;
}
</style>
