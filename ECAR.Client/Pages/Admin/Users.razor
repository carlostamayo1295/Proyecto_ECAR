@page "/admin/users"
@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<AdminRouteGuard>
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Gestión de Usuarios</MudText>
                <MudText Typo="Typo.body2">Administrar los usuarios del sistema</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    Nuevo Usuario
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <MudTextField T="string" Label="Buscar" @bind-Value="searchText" Variant="Variant.Outlined" 
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                Class="mb-4" />

            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (usuarios != null && usuarios.Any())
            {
                <MudTable Items="usuarios" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Nombre</MudTh>
                        <MudTh>Correo</MudTh>
                        <MudTh>Usuario AD</MudTh>
                        <MudTh>Roles</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.IdUsuario.ToString()</MudTd>
                        <MudTd>@context.Nombre</MudTd>
                        <MudTd>@context.Correo</MudTd>
                        <MudTd>@(context.UsuarioAD ?? "-")</MudTd>
                        <MudTd>
                            @if (context.Roles != null && context.Roles.Any())
                            {
                                @string.Join(", ", context.Roles)
                            }
                            else
                            {
                                <MudText Typo="Typo.caption">Sin roles</MudText>
                            }
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Color="@(context.Activo ? Color.Success : Color.Error)" 
                                Size="Size.Small" Variant="Variant.Outlined" Text="@(context.Activo ? "Activo" : "Inactivo")" />
                        </MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" 
                                StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialog(context)" Class="action-button">
                                Editar
                            </MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" 
                                StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteUser(context)" Class="action-button">
                                @(context.Activo ? "Desactivar" : "Activar")
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudPagination Class="mt-4" Count="@totalPages" Selected="@currentPage" 
                    SelectedPageChanged="HandlePageChange" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    No hay usuarios para mostrar
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
    </MudContainer>
</AdminRouteGuard>

@code {
    private List<UsuarioDto>? usuarios;
    private List<RolDto>? availableRoles;
    private string searchText = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        
        try
        {
            // Cargar los usuarios
            var usersResult = await HttpClientService.GetUsuariosAsync(currentPage, pageSize, searchText);
            
            if (usersResult != null && usersResult.Success && usersResult.Data != null)
            {
                usuarios = usersResult.Data.Data ?? new List<UsuarioDto>();
                totalPages = usersResult.Data.TotalPages;
            }
            else
            {
                Snackbar.Add(usersResult?.Message ?? "Error al cargar usuarios", Severity.Error);
                usuarios = new List<UsuarioDto>();
                totalPages = 1;
            }

            // Cargar los roles disponibles
            var rolesResult = await HttpClientService.GetRolesAsync(1, 100); // Traer todos los roles
            if (rolesResult != null && rolesResult.Success && rolesResult.Data != null)
            {
                availableRoles = rolesResult.Data.Data ?? new List<RolDto>();
            }
            else
            {
                availableRoles = new List<RolDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            usuarios = new List<UsuarioDto>();
            availableRoles = new List<RolDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadDataAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["AvailableRoles"] = availableRoles };
        var dialog = await DialogService.ShowAsync<UserModal>("Crear Nuevo Usuario", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenEditDialog(UsuarioDto usuario)
    {
        var parameters = new DialogParameters 
        { 
            ["Usuario"] = usuario,
            ["AvailableRoles"] = availableRoles
        };
        var dialog = await DialogService.ShowAsync<UserModal>("Editar Usuario", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task DeleteUser(UsuarioDto usuario)
    {
        var action = usuario.Activo ? "desactivar" : "activar";
        var parameters = new DialogParameters { ["Message"] = $"¿Está seguro que desea {action} el usuario '{usuario.Nombre}'?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>($"Confirmar {action}", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            isLoading = true;
            try
            {
                var deleteResult = await HttpClientService.DeleteUsuarioAsync(usuario.IdUsuario);
                
                if (deleteResult != null && deleteResult.Success)
                {
                    Snackbar.Add($"Usuario {action} exitosamente", Severity.Success);
                    await LoadDataAsync();
                }
                else
                {
                    Snackbar.Add(deleteResult?.Message ?? $"Error al {action} usuario", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
    }
}

<style>
.action-button {
    border-radius: 8px !important;
    font-weight: 500 !important;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2) !important;
    transition: all 0.2s ease !important;
}

.action-button:hover {
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3) !important;
    transform: translateY(-1px) !important;
}
</style>