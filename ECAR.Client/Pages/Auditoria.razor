@page "/auditoria"
@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Auditoría</MudText>
                <MudText Typo="Typo.body2">Historial de cambios registrados en el sistema</MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudTextField T="string" Label="Buscar por tabla, acción o usuario" @bind-Value="searchText" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                Class="mb-4" />

            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (registros != null && registros.Any())
            {
                <MudTable Items="registros" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Fecha y Hora</MudTh>
                        <MudTh>Tabla</MudTh>
                        <MudTh>Registro</MudTh>
                        <MudTh>Acción</MudTh>
                        <MudTh>Usuario</MudTh>
                        <MudTh>Detalle</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                        <MudTd>@context.Tabla</MudTd>
                        <MudTd>@context.RegistroId</MudTd>
                        <MudTd>
                            <MudChip T="string" Color="@AccionColor(context.Accion)" Size="Size.Small" Variant="Variant.Outlined" Text="@context.Accion" />
                        </MudTd>
                        <MudTd>@context.Usuario</MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => OpenDetailDialog(context)" Class="action-button">
                                Ver
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudPagination Class="mt-4" Count="@totalPages" Selected="@currentPage"
                    SelectedPageChanged="HandlePageChange" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    No hay registros de auditoría para mostrar
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<AuditoriaDto>? registros;
    private string searchText = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuditoriaAsync();
    }

    private async Task LoadAuditoriaAsync()
    {
        isLoading = true;

        try
        {
            var result = await HttpClientService.GetAuditoriaAsync(currentPage, pageSize, searchText);

            if (result != null && result.Success && result.Data != null)
            {
                registros = result.Data.Data ?? new List<AuditoriaDto>();
                totalPages = result.Data.TotalPages;
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Error al cargar la auditoría", Severity.Error);
                registros = new List<AuditoriaDto>();
                totalPages = 1;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            registros = new List<AuditoriaDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadAuditoriaAsync();
    }

    private async Task OpenDetailDialog(AuditoriaDto registro)
    {
        var parameters = new DialogParameters { ["Registro"] = registro };
        await DialogService.ShowAsync<AuditoriaDetailModal>("Detalle del Registro", parameters);
    }

    private static Color AccionColor(string accion) => accion.ToUpperInvariant() switch
    {
        "INSERT" or "CREATE" or "CREAR" => Color.Success,
        "UPDATE" or "EDITAR" => Color.Info,
        "DELETE" or "ELIMINAR" => Color.Error,
        _ => Color.Default
    };
}

<style>
.action-button {
    border-radius: 8px !important;
    font-weight: 500 !important;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2) !important;
    transition: all 0.2s ease !important;
}

.action-button:hover {
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3) !important;
    transform: translateY(-1px) !important;
}
</style>
