@page "/cambiar-password"
@inject HttpClientService HttpClientService
@inject AuthService AuthService
@inject NavigationManager NavigationManager

@* Cambio de contraseña. Se llega aquí desde el menú o, tras iniciar
   sesión, cuando el servidor responde debeCambiarPassword *@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6 mb-6">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-1">Cambiar contraseña</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Por seguridad, su contraseña debe cumplir la política de ECAR. Al cambiarla se cerrará su sesión
            y deberá iniciar sesión con la nueva contraseña.
        </MudText>

        @if (_cargando)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
        }
        else
        {
            <MudTextField T="string" Label="Contraseña actual" @bind-Value="_actual" Immediate="true"
                          Variant="Variant.Outlined" Class="mb-3" Disabled="@_enviando"
                          InputType="@(_mostrar ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_mostrar ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _mostrar = !_mostrar)" />

            <MudTextField T="string" Label="Nueva contraseña" @bind-Value="_nueva" Immediate="true"
                          Variant="Variant.Outlined" Class="mb-3" Disabled="@_enviando"
                          InputType="@(_mostrar ? InputType.Text : InputType.Password)" />

            <MudTextField T="string" Label="Confirmar nueva contraseña" @bind-Value="_confirmar" Immediate="true"
                          Variant="Variant.Outlined" Class="mb-3" Disabled="@_enviando"
                          InputType="@(_mostrar ? InputType.Text : InputType.Password)"
                          OnKeyUp="@ManejarEnter" />

            <MudText Typo="Typo.subtitle2" Class="mb-1">Requisitos</MudText>
            @foreach (var (cumple, texto) in Reglas())
            {
                <div class="d-flex align-center mb-1">
                    <MudIcon Icon="@(cumple ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                             Color="@(cumple ? Color.Success : Color.Default)" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.body2">@texto</MudText>
                </div>
            }

            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mt-2">
                No puede repetir sus últimas @_politica.PasswordsRecordadas contraseñas.
                @* Desde el 29/10/2026 no caduca (0 días); el aviso vuelve si se configura la caducidad. *@
                @if (_politica.DiasExpiracionPassword > 0)
                {
                    <span>La contraseña vence cada @_politica.DiasExpiracionPassword días.</span>
                }
            </MudText>

            @if (!string.IsNullOrEmpty(_error))
            {
                @* F-35: el API dice por qué no la cambió (B-06): actual incorrecta o cada regla que no cumple. *@
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">
                    @_error
                    @if (_motivos.Count > 0)
                    {
                        <ul class="motivos-password">
                            @foreach (var motivo in _motivos)
                            {
                                <li>@motivo</li>
                            }
                        </ul>
                    }
                </MudAlert>
            }

            <div class="d-flex justify-end mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(_enviando || !TodoCumple)" OnClick="CambiarAsync">
                    @if (_enviando)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Cambiando…</span>
                    }
                    else
                    {
                        <span>Cambiar contraseña</span>
                    }
                </MudButton>
            </div>
        }
    </MudPaper>
</MudContainer>

<style>
    .motivos-password {
        margin: 0.25rem 0 0;
        padding-left: 1.25rem;
        list-style: disc;
    }
</style>

@code {
    // Página a la que volver después de iniciar sesión con la nueva contraseña.
    [SupplyParameterFromQuery(Name = "returnUrl")]
    [Parameter]
    public string? ReturnUrl { get; set; }

    private PoliticaSeguridadDto _politica = new();
    private bool _cargando = true;
    private bool _enviando;
    private bool _mostrar;
    private string _actual = string.Empty;
    private string _nueva = string.Empty;
    private string _confirmar = string.Empty;
    private string? _error;
    private List<string> _motivos = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAuthenticated())
        {
            NavigationManager.NavigateTo("/login?returnUrl=%2Fcambiar-password", replace: true);
            return;
        }

        var respuesta = await HttpClientService.GetPoliticaSeguridadAsync();
        if (respuesta.Success && respuesta.Data != null)
        {
            _politica = respuesta.Data;
        }
        // Si el endpoint aún no existe se conservan los valores por defecto del plan.

        _cargando = false;
    }

    private bool CumpleLongitud => _nueva.Length >= _politica.LongitudMinimaPassword;
    private bool TieneLetra => _nueva.Any(char.IsLetter);
    private bool TieneNumero => _nueva.Any(char.IsDigit);
    private bool DiferenteDeActual => _nueva.Length > 0 && _nueva != _actual;
    private bool Coincide => _confirmar.Length > 0 && _nueva == _confirmar;

    private bool TodoCumple =>
        !string.IsNullOrEmpty(_actual)
        && CumpleLongitud
        && (!_politica.RequiereLetrasYNumeros || (TieneLetra && TieneNumero))
        && DiferenteDeActual
        && Coincide;

    private IEnumerable<(bool Cumple, string Texto)> Reglas()
    {
        yield return (CumpleLongitud, $"Al menos {_politica.LongitudMinimaPassword} caracteres");

        if (_politica.RequiereLetrasYNumeros)
        {
            yield return (TieneLetra, "Contiene letras");
            yield return (TieneNumero, "Contiene números");
        }

        yield return (DiferenteDeActual, "Es distinta de la contraseña actual");
        yield return (Coincide, "La confirmación coincide");
    }

    private async Task ManejarEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && TodoCumple && !_enviando)
        {
            await CambiarAsync();
        }
    }

    private async Task CambiarAsync()
    {
        if (!TodoCumple || _enviando)
        {
            return;
        }

        _enviando = true;
        _error = null;
        _motivos = new();

        var respuesta = await HttpClientService.CambiarPasswordAsync(new CambiarPasswordDto
        {
            Actual = _actual,
            Nueva = _nueva
        });

        _enviando = false;

        if (!respuesta.Success)
        {
            // 400 (actual incorrecta, no cumple la política, repetida) o 423 (cuenta bloqueada):
            // el mensaje ya viene armado por el servidor y, en el 400, los motivos llegan en Errors.
            _error = string.IsNullOrWhiteSpace(respuesta.Message)
                ? "No se pudo cambiar la contraseña. Intente de nuevo."
                : respuesta.Message;
            _motivos = respuesta.Errors?.Where(m => !string.IsNullOrWhiteSpace(m)).ToList() ?? new();
            _actual = string.Empty;
            return;
        }

        // El servidor renueva el SecurityStamp: el token anterior deja de valer, así que se cierra
        // la sesión y se vuelve a entrar con la nueva contraseña.
        await AuthService.ClearTokenAsync();
        var destino = DestinoSeguro();
        var url = "/login?passwordCambiada=1" + (destino == "/" ? string.Empty : "&returnUrl=" + Uri.EscapeDataString(destino));
        NavigationManager.NavigateTo(url, forceLoad: true);
    }

    // Misma regla que Login.razor: solo rutas de esta aplicación (evita redirección abierta).
    private string DestinoSeguro()
    {
        var destino = ReturnUrl?.Trim();

        if (string.IsNullOrEmpty(destino)
            || destino.Contains("://")
            || destino.StartsWith('\\')
            || (destino.Length > 1 && destino[0] == '/' && (destino[1] == '/' || destino[1] == '\\'))
            || !Uri.TryCreate(destino, UriKind.Relative, out _))
        {
            return "/";
        }

        var ruta = destino.TrimStart('/');
        if (ruta.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            || ruta.StartsWith("cambiar-password", StringComparison.OrdinalIgnoreCase))
        {
            return "/";
        }

        return "/" + ruta;
    }
}
