@page "/checklists"
@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Checklists</MudText>
                <MudText Typo="Typo.body2">Administrar los checklists de inspección del sistema</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    Nuevo Checklist
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <MudTextField T="string" Label="Buscar" @bind-Value="searchText" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                Class="mb-4" />

            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (checklists != null && checklists.Any())
            {
                <MudTable Items="checklists" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Nombre</MudTh>
                        <MudTh>Versión</MudTh>
                        <MudTh>Preguntas</MudTh>
                        <MudTh>Fecha Creación</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.IdChecklist.ToString()</MudTd>
                        <MudTd>@context.Nombre</MudTd>
                        <MudTd>@context.Version</MudTd>
                        <MudTd>@context.Preguntas.Count</MudTd>
                        <MudTd>@context.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd>
                            <MudChip T="string" Color="@(context.Activo ? Color.Success : Color.Error)"
                                Size="Size.Small" Variant="Variant.Outlined" Text="@(context.Activo ? "Activo" : "Inactivo")" />
                        </MudTd>
                        <MudTd>
                            <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => OpenViewDialog(context)" Class="action-button">
                                Ver
                            </MudButton>
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialog(context)" Class="action-button">
                                Editar
                            </MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteChecklist(context)" Class="action-button">
                                @(context.Activo ? "Desactivar" : "Activar")
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudPagination Class="mt-4" Count="@totalPages" Selected="@currentPage"
                    SelectedPageChanged="HandlePageChange" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    No hay checklists para mostrar
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<ChecklistDto>? checklists;
    private string searchText = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadChecklistsAsync();
    }

    private async Task LoadChecklistsAsync()
    {
        isLoading = true;

        try
        {
            var result = await HttpClientService.GetChecklistsAsync(currentPage, pageSize, searchText);

            if (result != null && result.Success && result.Data != null)
            {
                checklists = result.Data.Data ?? new List<ChecklistDto>();
                totalPages = result.Data.TotalPages;
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Error al cargar checklists", Severity.Error);
                checklists = new List<ChecklistDto>();
                totalPages = 1;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            checklists = new List<ChecklistDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadChecklistsAsync();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<ChecklistModal>("Crear Nuevo Checklist");
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadChecklistsAsync();
        }
    }

    private async Task OpenEditDialog(ChecklistDto checklist)
    {
        var parameters = new DialogParameters { ["Checklist"] = checklist };
        var dialog = await DialogService.ShowAsync<ChecklistModal>("Editar Checklist", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadChecklistsAsync();
        }
    }

    private async Task OpenViewDialog(ChecklistDto checklist)
    {
        var parameters = new DialogParameters { ["Checklist"] = checklist };
        await DialogService.ShowAsync<ChecklistDetailModal>("Detalle del Checklist", parameters);
    }

    private async Task DeleteChecklist(ChecklistDto checklist)
    {
        var action = checklist.Activo ? "desactivar" : "activar";
        var parameters = new DialogParameters { ["Message"] = $"¿Está seguro que desea {action} el checklist '{checklist.Nombre}'?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>($"Confirmar {action}", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            isLoading = true;
            try
            {
                var deleteResult = await HttpClientService.DeleteChecklistAsync(checklist.IdChecklist);

                if (deleteResult != null && deleteResult.Success)
                {
                    Snackbar.Add($"Checklist {action} exitosamente", Severity.Success);
                    await LoadChecklistsAsync();
                }
                else
                {
                    Snackbar.Add(deleteResult?.Message ?? $"Error al {action} checklist", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
    }
}

<style>
.action-button {
    border-radius: 8px !important;
    font-weight: 500 !important;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2) !important;
    transition: all 0.2s ease !important;
}

.action-button:hover {
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3) !important;
    transform: translateY(-1px) !important;
}
</style>
