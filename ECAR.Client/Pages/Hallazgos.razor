@page "/hallazgos"
@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthorizationService AuthorizationService

<RolRouteGuard Roles="@(new[] { "Administrador", "Técnico", "Auditor" })">
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h5">Hallazgos</MudText>
                    <MudText Typo="Typo.body2">Novedades registradas durante las inspecciones</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    @if (puedeGestionar)
                    {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                        Nuevo Hallazgo
                    </MudButton>
                    }
                </CardHeaderActions>
            </MudCardHeader>

            <MudCardContent>
                <MudGrid Class="mb-2">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Buscar por equipo, descripción o criticidad" @bind-Value="searchText" Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                                      OnKeyUp="OnSearchKeyUp" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string" Label="Estado" Value="estadoFiltro" Variant="Variant.Outlined"
                                   Clearable="true" ValueChanged="OnEstadoChanged">
                            @foreach (var estado in HallazgoEstados.Todos)
                            {
                            <MudSelectItem T="string" Value="@estado">@EtiquetaEstado(estado)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string" Label="Criticidad" Value="criticidadFiltro" Variant="Variant.Outlined"
                                   Clearable="true" ValueChanged="OnCriticidadChanged">
                            <MudSelectItem T="string" Value="@("Alta")">Alta</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Media")">Media</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Baja")">Baja</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="long?" Label="Equipo" Value="equipoFiltro" Variant="Variant.Outlined"
                                   Clearable="true" ValueChanged="OnEquipoChanged">
                            @foreach (var equipo in equipos)
                            {
                            <MudSelectItem T="long?" Value="@((long?)equipo.IdEquipo)">@equipo.CodigoInterno - @equipo.NombreEquipo</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker Label="Desde" Date="fechaDesde" DateChanged="OnFechaDesdeChanged"
                                       Variant="Variant.Outlined" Clearable="true" DateFormat="dd/MM/yyyy" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker Label="Hasta" Date="fechaHasta" DateChanged="OnFechaHastaChanged"
                                       Variant="Variant.Outlined" Clearable="true" DateFormat="dd/MM/yyyy" />
                    </MudItem>
                </MudGrid>

                @if (isLoading)
                {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
                }
                else if (hallazgos != null && hallazgos.Any())
                {
                <MudTable Items="hallazgos" Hover="true" Striped="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Equipo</MudTh>
                        <MudTh>Área</MudTh>
                        <MudTh>Descripción</MudTh>
                        <MudTh>Origen</MudTh>
                        <MudTh>Criticidad</MudTh>
                        <MudTh>Responsable</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.IdHallazgo</MudTd>
                        <MudTd DataLabel="Equipo">@context.NombreEquipo</MudTd>
                        <MudTd DataLabel="Área">@(context.Area ?? "-")</MudTd>
                        <MudTd DataLabel="Descripción">@Truncar(context.Descripcion)</MudTd>
                        <MudTd DataLabel="Origen">@(context.Origen ?? "-")</MudTd>
                        <MudTd DataLabel="Criticidad">
                            <MudChip T="string" Color="@CriticidadColor(context.Criticidad)"
                                     Size="Size.Small" Variant="Variant.Filled" Text="@(context.Criticidad ?? "-")" />
                        </MudTd>
                        <MudTd DataLabel="Responsable">@(context.NombreResponsable ?? "Sin asignar")</MudTd>
                        <MudTd DataLabel="Estado">
                            <MudChip T="string" Color="@EstadoColor(context.Estado)"
                                     Size="Size.Small" Variant="Variant.Outlined" Text="@EtiquetaEstado(context.Estado)" />
                        </MudTd>
                        <MudTd DataLabel="Fecha">@context.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Acciones">
                            <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => OpenViewDialog(context)" Class="action-button">
                                Ver
                            </MudButton>
                            @if (PuedeEditar(context))
                            {
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialog(context)" Class="action-button">
                                Editar
                            </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudPagination Class="mt-4" Count="@totalPages" Selected="@currentPage"
                               SelectedChanged="HandlePageChange" />
                }
                else
                {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    No hay hallazgos para mostrar
                </MudAlert>
                }
            </MudCardContent>
        </MudCard>
    </MudContainer>
</RolRouteGuard>

@code {
private List<HallazgoDto>? hallazgos;
private string searchText = string.Empty;
private string? estadoFiltro;
private string? criticidadFiltro;
private long? equipoFiltro;
private List<EquipoDto> equipos = new();
private DateTime? fechaDesde;
private DateTime? fechaHasta;
private int currentPage = 1;
private int pageSize = 10;
private int totalPages = 1;
private bool isLoading = false;
private bool puedeGestionar;

protected override async Task OnInitializedAsync()
{
var roles = await AuthorizationService.GetUserRolesAsync();
puedeGestionar = roles.Contains("Administrador") || roles.Contains("Técnico");

// Equipos activos para el filtro; si la consulta falla, la lista queda vacía y el resto funciona
var respuestaEquipos = await HttpClientService.GetEquiposAsync(1, 100, activo: true);
equipos = respuestaEquipos?.Data?.Data ?? new List<EquipoDto>();

await LoadHallazgosAsync();
}

private async Task LoadHallazgosAsync()
{
isLoading = true;

try
{
var filtro = new HallazgoFiltroDto
{
Search = string.IsNullOrWhiteSpace(searchText) ? null : searchText.Trim(),
Estado = estadoFiltro,
Criticidad = criticidadFiltro,
IdEquipo = equipoFiltro,
Desde = fechaDesde?.Date,
// "Hasta" incluye todo el día elegido (hasta las 23:59:59)
Hasta = fechaHasta?.Date.AddDays(1).AddSeconds(-1)
};
var result = await HttpClientService.BuscarHallazgosAsync(filtro, currentPage, pageSize);

if (result != null && result.Success && result.Data != null)
{
hallazgos = result.Data.Data ?? new List<HallazgoDto>();
totalPages = result.Data.TotalPages;
}
else
{
Snackbar.Add(result?.Message ?? "Error al cargar hallazgos", Severity.Error);
hallazgos = new List<HallazgoDto>();
totalPages = 1;
}
}
catch (Exception ex)
{
Snackbar.Add($"Error: {ex.Message}", Severity.Error);
hallazgos = new List<HallazgoDto>();
}
finally
{
isLoading = false;
}
}

private async Task OnSearchKeyUp(KeyboardEventArgs args)
{
if (args.Key == "Enter")
{
currentPage = 1;
await LoadHallazgosAsync();
}
}

private async Task OnEstadoChanged(string? value)
{
estadoFiltro = value;
await AplicarFiltrosAsync();
}

private async Task OnCriticidadChanged(string? value)
{
criticidadFiltro = value;
await AplicarFiltrosAsync();
}

private async Task OnEquipoChanged(long? value)
{
equipoFiltro = value;
await AplicarFiltrosAsync();
}

private async Task OnFechaDesdeChanged(DateTime? value)
{
fechaDesde = value;
await AplicarFiltrosAsync();
}

private async Task OnFechaHastaChanged(DateTime? value)
{
fechaHasta = value;
await AplicarFiltrosAsync();
}

// Un solo lugar para aplicar cualquier filtro: valida las fechas y vuelve a la página 1
private async Task AplicarFiltrosAsync()
{
if (fechaDesde.HasValue && fechaHasta.HasValue && fechaDesde > fechaHasta)
{
Snackbar.Add("La fecha \"Desde\" no puede ser posterior a \"Hasta\".", Severity.Warning);
return;
}

currentPage = 1;
await LoadHallazgosAsync();
}

private async Task HandlePageChange(int newPage)
{
currentPage = newPage;
await LoadHallazgosAsync();
}

private async Task OpenCreateDialog()
{
var dialog = await DialogService.ShowAsync<HallazgoModal>("Registrar Nuevo Hallazgo");
var result = await dialog.Result;

if (result is not null && !result.Canceled)
{
await LoadHallazgosAsync();
}
}

private async Task OpenEditDialog(HallazgoDto hallazgo)
{
var parameters = new DialogParameters { ["Hallazgo"] = hallazgo };
var dialog = await DialogService.ShowAsync<HallazgoModal>("Editar Hallazgo", parameters);
var result = await dialog.Result;

if (result is not null && !result.Canceled)
{
await LoadHallazgosAsync();
}
}

private async Task OpenViewDialog(HallazgoDto hallazgo)
{
    var parameters = new DialogParameters { ["Hallazgo"] = hallazgo };
    var dialog = await DialogService.ShowAsync<HallazgoDetailModal>("Detalle del Hallazgo", parameters);
    await dialog.Result;
    await LoadHallazgosAsync();
}

// Plan, endpoint 7: solo Administrador y Técnico editan, y solo en Abierto o EnProceso.
// Un hallazgo Cerrado o Anulado es histórico y no se modifica.
private bool PuedeEditar(HallazgoDto hallazgo) =>
puedeGestionar &&
(hallazgo.Estado == HallazgoEstados.Abierto || hallazgo.Estado == HallazgoEstados.EnProceso);

private static string Truncar(string? texto) =>
string.IsNullOrEmpty(texto) ? "-" : texto.Length > 60 ? texto[..60] + "…" : texto;

// Colores del plan: Abierto = rojo, EnProceso = naranja, Cerrado = verde, Anulado = gris
private static Color EstadoColor(string? estado) => estado switch
{
HallazgoEstados.Abierto => Color.Error,
HallazgoEstados.EnProceso => Color.Warning,
HallazgoEstados.Cerrado => Color.Success,
_ => Color.Default
};

// "EnProceso" se muestra como "En proceso"
private static string EtiquetaEstado(string? estado) => estado switch
{
HallazgoEstados.EnProceso => "En proceso",
null or "" => "-",
_ => estado
};

private static Color CriticidadColor(string? criticidad) => (criticidad ?? string.Empty).ToLowerInvariant() switch
{
"alta" => Color.Error,
"media" => Color.Warning,
"baja" => Color.Info,
_ => Color.Default
};
}

<style>
    .action-button {
        border-radius: 8px !important;
        font-weight: 500 !important;
        box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2) !important;
        transition: all 0.2s ease !important;
    }

    .action-button:hover {
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3) !important;
        transform: translateY(-1px) !important;
    }
</style>
