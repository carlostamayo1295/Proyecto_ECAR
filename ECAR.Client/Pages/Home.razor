@page "/"
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar

@using ECAR.Client.Services
@using ECAR.Shared
@using ECAR.Shared.DTOs
@using MudBlazor

@*
  Portada. Sin sesión: bienvenida y acceso al login. Con sesión: el tablero de indicadores del
  SRS §6 (equipos, inspecciones y novedades), calculado por GET api/dashboard, con filtros por
  periodo y planta (F-21), la tendencia semanal (F-22) y la exportación a PDF (F-23).
*@
<MudContainer MaxWidth="MaxWidth.Large" Class="home-container">
    @if (cargando)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (!autenticado)
    {
        <MudCard Class="welcome-card">
            <MudCardContent>
                <MudText Typo="Typo.h3" Class="welcome-title">Bienvenido al Sistema de Auditoría de Equipos</MudText>
                <MudText Typo="Typo.body1" Class="welcome-subtitle">Sistema de gestión de equipos e inspecciones para Laboratorios ECAR S.A.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="login-button" OnClick="GoToLogin">
                    Iniciar Sesión
                </MudButton>
            </MudCardContent>
        </MudCard>

        <MudGrid Spacing="6" Class="features-grid">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="feature-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Large" Color="Color.Secondary" Class="feature-icon" />
                        <MudText Typo="Typo.h5" Class="feature-title">Equipos</MudText>
                        <MudText Typo="Typo.body2" Class="feature-description">Gestión completa del inventario de equipos y sus ubicaciones.</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="feature-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Primary" Class="feature-icon" />
                        <MudText Typo="Typo.h5" Class="feature-title">Inspecciones</MudText>
                        <MudText Typo="Typo.body2" Class="feature-description">Programación y ejecución de inspecciones periódicas de equipos.</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="feature-card">
                    <MudCardContent>
                        <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Large" Color="Color.Secondary" Class="feature-icon" />
                        <MudText Typo="Typo.h5" Class="feature-title">Reportes</MudText>
                        <MudText Typo="Typo.body2" Class="feature-description">Generación de reportes y auditoría regulatoria.</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
    else if (tablero == null)
    {
        <MudAlert Severity="Severity.Warning" Class="my-4">@mensajeError</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarAsync" StartIcon="@Icons.Material.Filled.Refresh">
            Reintentar
        </MudButton>
    }
    else
    {
        <div class="tablero-cabecera">
            <div>
                <MudText Typo="Typo.h4" Class="welcome-title">Tablero</MudText>
                @* F-21: el periodo y la planta que aplicó el servidor se ven en el título. *@
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Indicadores de @tablero.Periodo · @(tablero.Filtros.Planta ?? "todas las plantas")
                    · actualizado a las @FormatoEstados.HoraColombia(tablero.GeneradoEn, "HH:mm") (hora de Colombia)
                </MudText>
            </div>
            <div class="tablero-acciones">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CargarAsync" StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@actualizando" title="Actualizar indicadores">
                    Actualizar
                </MudButton>
                @* F-23: el PDF lleva los mismos filtros que la pantalla y queda en la auditoría (B-03). *@
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportarPdfAsync" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           Disabled="@exportando" title="Descargar el tablero en PDF con los filtros aplicados">
                    @(exportando ? "Generando…" : "Exportar PDF")
                </MudButton>
            </div>
        </div>

        <MudPaper Class="tablero-filtros" Elevation="1">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Periodo" Value="@periodo" ValueChanged="CambiarPeriodoAsync"
                               Variant="Variant.Outlined" Dense="true">
                        @foreach (var (clave, texto) in OpcionesPeriodo())
                        {
                            <MudSelectItem T="string" Value="@clave">@texto</MudSelectItem>
                        }
                        <MudSelectItem T="string" Value="@PeriodoRango">Rango de fechas</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (periodo == PeriodoRango)
                {
                    <MudItem xs="6" sm="3" md="2">
                        <MudDatePicker Label="Desde" Date="@rangoDesde" DateChanged="CambiarDesdeAsync" Variant="Variant.Outlined"
                                       Editable="true" DateFormat="dd/MM/yyyy" MaxDate="@Hoy" />
                    </MudItem>
                    <MudItem xs="6" sm="3" md="2">
                        <MudDatePicker Label="Hasta" Date="@rangoHasta" DateChanged="CambiarHastaAsync" Variant="Variant.Outlined"
                                       Editable="true" DateFormat="dd/MM/yyyy" MaxDate="@Hoy" />
                    </MudItem>
                }
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" Label="Planta" Value="@planta" ValueChanged="CambiarPlantaAsync"
                               Variant="Variant.Outlined" Dense="true" Clearable="true" Placeholder="Todas las plantas">
                        @foreach (var nombre in plantas)
                        {
                            <MudSelectItem T="string" Value="@nombre">@nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            @if (actualizando)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
            }
            @if (!string.IsNullOrEmpty(errorFiltros))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@errorFiltros</MudAlert>
            }
        </MudPaper>

        <MudGrid Spacing="3" Class="mb-2">
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="indicador" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Filled.Devices" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.h4">@tablero.TotalEquipos</MudText>
                        <MudText Typo="Typo.body2">Equipos activos</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="indicador" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Success" />
                    <div>
                        <MudText Typo="Typo.h4">@tablero.InspeccionesRealizadasMes</MudText>
                        <MudText Typo="Typo.body2">Inspecciones realizadas en @tablero.Periodo</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@tablero.InspeccionesRealizadas firmadas en total</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="indicador" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" />
                    <div>
                        <MudText Typo="Typo.h4">@tablero.InspeccionesEnCurso</MudText>
                        <MudText Typo="Typo.body2">Inspecciones en curso</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">iniciadas en el periodo y todavía sin firmar</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="indicador" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" />
                    <div>
                        <MudText Typo="Typo.h4">@tablero.NovedadesPendientes</MudText>
                        <MudText Typo="Typo.body2">Novedades pendientes</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            registradas en el periodo; @tablero.InspeccionesConNovedadesPendientes inspección(es) firmada(s) sin cerrar
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Class="indicador" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" />
                    <div>
                        <MudText Typo="Typo.h4">@tablero.NovedadesResueltas</MudText>
                        <MudText Typo="Typo.body2">Novedades resueltas</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">resueltas con firma en el periodo</MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* F-22: tendencia de las últimas 8 semanas (B-02), de lunes a domingo en hora de Colombia. Solo
           depende de la planta: el periodo de arriba no la cambia. La tabla da los mismos números en el
           teléfono y para quien no distingue los colores. *@
        <MudPaper Class="pa-4 mb-4 tendencia" Elevation="1">
            <MudText Typo="Typo.h6">Tendencia de las últimas @SemanasTendencia semanas</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                Por semana, de lunes a domingo · @(planta ?? "todas las plantas") · no depende del periodo
            </MudText>
            @if (tendencia is null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@(errorTendencia ?? "Cargando la tendencia…")</MudText>
            }
            else
            {
                <div class="tendencia-grafica">
                    <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@seriesTendencia" ChartLabels="@etiquetasTendencia"
                              ChartOptions="@opcionesTendencia" Width="100%" Height="280px" />
                </div>
                <MudTable Items="@tendencia.Datos" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None"
                          Class="tendencia-tabla mt-2">
                    <HeaderContent>
                        <MudTh>Semana del</MudTh>
                        <MudTh Style="text-align:right">Firmadas</MudTh>
                        <MudTh Style="text-align:right">Novedades</MudTh>
                        <MudTh Style="text-align:right">Resueltas</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd title="@($"{context.Desde:dd/MM/yyyy} al {context.Hasta:dd/MM/yyyy}")">@context.Desde.ToString("dd/MM")</MudTd>
                        <MudTd Style="text-align:right">@context.InspeccionesFirmadas</MudTd>
                        <MudTd Style="text-align:right">@context.NovedadesRegistradas</MudTd>
                        <MudTd Style="text-align:right">@context.NovedadesResueltas</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">Equipos por criticidad</MudText>
                    @foreach (var fila in tablero.EquiposPorCriticidad)
                    {
                        <div class="barra-fila">
                            <div class="barra-etiqueta">
                                <MudText Typo="Typo.body2">@fila.Etiqueta</MudText>
                                <MudText Typo="Typo.body2"><b>@fila.Cantidad</b></MudText>
                            </div>
                            <MudProgressLinear Color="@ColorCriticidad(fila.Etiqueta)" Value="@Porcentaje(fila.Cantidad)" Rounded="true" Size="Size.Medium"
                                               aria-label="@($"{fila.Etiqueta}: {fila.Cantidad} equipos")" />
                        </div>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">Equipos por área</MudText>
                    @if (tablero.EquiposPorArea.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No hay equipos activos.</MudText>
                    }
                    @foreach (var fila in tablero.EquiposPorArea)
                    {
                        <div class="barra-fila">
                            <div class="barra-etiqueta">
                                <MudText Typo="Typo.body2" Class="texto-area">@fila.Etiqueta</MudText>
                                <MudText Typo="Typo.body2"><b>@fila.Cantidad</b></MudText>
                            </div>
                            <MudProgressLinear Color="Color.Primary" Value="@Porcentaje(fila.Cantidad)" Rounded="true" Size="Size.Medium"
                                               aria-label="@($"{fila.Etiqueta}: {fila.Cantidad} equipos")" />
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

