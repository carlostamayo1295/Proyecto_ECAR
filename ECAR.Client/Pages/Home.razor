@code {
    private const string PeriodoRango = "rango";
    private const int SemanasTendencia = 8;

    // Mismo orden en la serie, la leyenda y la tabla (azul de ECAR, naranja y aguamarina); validados
    // para daltonismo sobre blanco. El aguamarina tiene poco contraste: por eso la tabla de abajo.
    private static readonly string[] ColoresTendencia = ["#397FDE", "#EB6834", "#1BAF7A"];

    private bool cargando = true;
    private bool autenticado;
    private DashboardDto? tablero;
    private string mensajeError = string.Empty;

    // F-21: «mes:0» es el mes en curso, «mes:1» el anterior… y «rango» las dos fechas.
    private string periodo = "mes:0";
    private DateTime? rangoDesde;
    private DateTime? rangoHasta;
    private string? planta;
    private List<string> plantas = new();
    private bool actualizando;
    private bool exportando;
    private string? errorFiltros;

    private DashboardTendenciaDto? tendencia;
    private string? errorTendencia;
    private List<ChartSeries<double>> seriesTendencia = new();
    private string[] etiquetasTendencia = [];
    private readonly LineChartOptions opcionesTendencia = new()
    {
        ChartPalette = ColoresTendencia,
        YAxisRequireZeroPoint = true,
        YAxisFormat = "0",
        // Conteos pequeños: con el paso por defecto (20) el eje iba de 0 a 20 y las líneas quedaban pegadas al piso.
        YAxisTicks = 1,
        MaxNumYAxisTicks = 6,
        LineStrokeWidth = 2,
        ShowDataMarkers = true
    };

    /// <summary>Hoy en Colombia (UTC−5), como los días del servidor.</summary>
    private static DateTime Hoy => DateTime.UtcNow.AddHours(-5).Date;

    protected override async Task OnInitializedAsync()
    {
        autenticado = await AuthService.IsAuthenticated();
        if (autenticado)
        {
            await Task.WhenAll(CargarPlantasAsync(), CargarAsync());
        }

        cargando = false;
    }

    private async Task CargarPlantasAsync()
    {
        // Ubicaciones las leen todos los roles; las plantas salen de ahí, sin repetir.
        var respuesta = await HttpClientService.GetUbicacionesAsync(1, 100);
        plantas = respuesta?.Success == true
            ? (respuesta.Data?.Data ?? new()).Select(u => u.Planta).Where(p => !string.IsNullOrWhiteSpace(p))
                .Distinct().OrderBy(p => p).ToList()
            : new();
    }

    private async Task CargarAsync()
    {
        var (desde, hasta) = RangoElegido();
        actualizando = true;
        errorFiltros = null;

        var pedidoTablero = HttpClientService.GetDashboardAsync(desde, hasta, planta);
        var pedidoTendencia = HttpClientService.GetTendenciaTableroAsync(SemanasTendencia, planta);
        var respuesta = await pedidoTablero;
        var respuestaTendencia = await pedidoTendencia;
        actualizando = false;

        if (respuesta.Success && respuesta.Data != null)
        {
            tablero = respuesta.Data;
        }
        else if (tablero == null)
        {
            // Sin datos todavía: pantalla de «Reintentar».
            mensajeError = respuesta.Message;
        }
        else
        {
            // Ya había un tablero: se conserva y el motivo (p. ej. un rango de más de un año) va junto a los filtros.
            errorFiltros = respuesta.Message;
        }

        MostrarTendencia(respuestaTendencia);
    }

    private void MostrarTendencia(ApiResponse<DashboardTendenciaDto> respuesta)
    {
        if (!respuesta.Success || respuesta.Data == null)
        {
            tendencia = null;
            errorTendencia = respuesta.Message;
            return;
        }

        tendencia = respuesta.Data;
        errorTendencia = null;
        etiquetasTendencia = tendencia.Datos.Select(s => s.Desde.ToString("dd/MM")).ToArray();
        seriesTendencia =
        [
            new() { Name = "Inspecciones firmadas", Data = tendencia.Datos.Select(s => (double)s.InspeccionesFirmadas).ToArray() },
            new() { Name = "Novedades registradas", Data = tendencia.Datos.Select(s => (double)s.NovedadesRegistradas).ToArray() },
            new() { Name = "Novedades resueltas", Data = tendencia.Datos.Select(s => (double)s.NovedadesResueltas).ToArray() }
        ];
    }

    /// <summary>
    /// Fechas que se envían al API (días de Colombia, ambos incluidos). En el rango, null mientras falte
    /// una de las dos: el servidor usaría el mes en curso y el título lo diría.
    /// </summary>
    private (DateTime? Desde, DateTime? Hasta) RangoElegido()
    {
        if (periodo == PeriodoRango)
        {
            return rangoDesde is { } d && rangoHasta is { } h ? (d.Date, h.Date) : (null, null);
        }

        var meses = int.TryParse(periodo.AsSpan(4), out var atras) ? atras : 0;
        var inicio = new DateTime(Hoy.Year, Hoy.Month, 1).AddMonths(-meses);
        var fin = meses == 0 ? Hoy : inicio.AddMonths(1).AddDays(-1);
        return (inicio, fin);
    }

    /// <summary>El mes en curso y los 11 anteriores, con el nombre que usa el servidor («octubre de 2026»).</summary>
    private static IEnumerable<(string Clave, string Texto)> OpcionesPeriodo()
    {
        var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
        var inicioMes = new DateTime(Hoy.Year, Hoy.Month, 1);
        yield return ("mes:0", "Mes en curso");
        for (var atras = 1; atras < 12; atras++)
        {
            yield return ($"mes:{atras}", inicioMes.AddMonths(-atras).ToString("MMMM 'de' yyyy", cultura));
        }
    }

    private async Task CambiarPeriodoAsync(string valor)
    {
        periodo = valor;
        if (periodo == PeriodoRango)
        {
            // Arranca con el periodo que se estaba viendo, para ajustarlo desde ahí.
            rangoDesde ??= tablero?.Filtros.Desde;
            rangoHasta ??= tablero?.Filtros.Hasta;
        }

        await CargarAsync();
    }

    private async Task CambiarDesdeAsync(DateTime? valor)
    {
        rangoDesde = valor;
        if (rangoDesde != null && rangoHasta != null)
        {
            await CargarAsync();
        }
    }

    private async Task CambiarHastaAsync(DateTime? valor)
    {
        rangoHasta = valor;
        if (rangoDesde != null && rangoHasta != null)
        {
            await CargarAsync();
        }
    }

    private async Task CambiarPlantaAsync(string? valor)
    {
        planta = string.IsNullOrWhiteSpace(valor) ? null : valor;
        await CargarAsync();
    }

    private async Task ExportarPdfAsync()
    {
        if (exportando || tablero == null)
        {
            return;
        }

        // Los filtros que el servidor aplicó a lo que se ve, para que el PDF diga lo mismo.
        exportando = true;
        var respuesta = await HttpClientService.DescargarTableroPdfAsync(tablero.Filtros.Desde, tablero.Filtros.Hasta,
            tablero.Filtros.Planta);
        exportando = false;

        if (!respuesta.Success)
        {
            Snackbar.Add(respuesta.Message, Severity.Error);
        }
    }

    /// <summary>Largo de la barra: proporción sobre el total de equipos activos.</summary>
    private double Porcentaje(int cantidad) =>
        tablero is { TotalEquipos: > 0 } t ? 100.0 * cantidad / t.TotalEquipos : 0;

    private static Color ColorCriticidad(string criticidad) => criticidad switch
    {
        Criticidades.Alta => Color.Error,
        Criticidades.Media => Color.Warning,
        Criticidades.Baja => Color.Success,
        _ => Color.Default
    };

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }
}
