@page "/inspecciones/iniciar"
@inject HttpClientService HttpClientService
@inject SesionService Sesion
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Inicio de una inspección desde el QR del equipo (FE-3) o, sin QR, eligiendo el equipo y el
   checklist en la propia página ("Selección de Equipo", SRS §6). Con ?equipo=&checklist= inicia
   directamente; sin ellos muestra el formulario de selección.

   Sin sesión, la guarda manda al login conservando esta URL y el técnico vuelve solo. Por eso
   dentro de la página cualquier respuesta sin Data es un error real y se muestra: no hay que
   adivinar si "no vino nada" significa "no hay sesión". Antes se adivinaba, y un 400 legítimo
   (equipo dado de baja, checklist inactivo) o la falta de red mandaban al login; con un equipo
   inactivo el técnico entraba en bucle: login, vuelve, 400, login.

   No usa EmptyLayout aunque ConsultaQr sí: EmptyLayout no monta MudSnackbarProvider ni
   MudPopoverProvider, y el aviso de "no autorizado" de la guarda no se vería. *@

<RolRouteGuard Roles="@(new[] { RolesSistema.Administrador, RolesSistema.Operador, RolesSistema.Estandar })"
               MensajeNoAutorizado="Solo operadores, usuarios estándar y administradores pueden iniciar inspecciones.">
<div class="d-flex justify-center align-center" style="min-height: 80vh;">
    <MudCard Elevation="2" Class="pa-6 text-center" Style="max-width: 480px; width: 100%;">
        @if (_seleccionando)
        {
            <MudText Typo="Typo.h6" Class="mb-1">Iniciar inspección</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Escanee la etiqueta QR del equipo o elíjalo de la lista, y luego el checklist.
            </MudText>

            <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" Class="mb-4"
                StartIcon="@Icons.Material.Filled.QrCodeScanner" OnClick="EscanearAsync" Disabled="@_resolviendoQr">
                @(_resolviendoQr ? "Buscando el equipo..." : "Escanear QR del equipo")
            </MudButton>

            <MudAutocomplete T="EquipoDto" Label="Equipo" @bind-Value="_equipo"
                SearchFunc="BuscarEquiposAsync" ToStringFunc="@(e => e == null ? string.Empty : $"{e.CodigoInterno} - {e.NombreEquipo}")"
                Variant="Variant.Outlined" MinCharacters="0" MaxItems="20" ResetValueOnEmptyText="true" Clearable="true"
                Class="mb-3 text-left" HelperText="Código, nombre, marca o serial. Solo equipos activos" />

            <MudSelect T="long?" Label="Checklist" @bind-Value="_idChecklist" Variant="Variant.Outlined"
                Class="mb-4 text-left" HelperText="Solo se listan los checklists activos">
                @foreach (var checklist in _checklists)
                {
                    <MudSelectItem T="long?" Value="@((long?)checklist.IdChecklist)">@($"{checklist.Nombre} (v{checklist.Version})")</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                StartIcon="@Icons.Material.Filled.PlayArrow"
                Disabled="@(_equipo == null || _idChecklist == null)" OnClick="IniciarSeleccionAsync">
                Iniciar inspección
            </MudButton>
        }
        else if (_cargando)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.h6">Iniciando inspección...</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                Por favor espere mientras se prepara la inspección del equipo.
            </MudText>
        }
        else if (_error != null)
        {
            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" Class="mb-2" />
            <MudText Typo="Typo.h6" Color="Color.Error">No se pudo iniciar</MudText>
            <MudText Typo="Typo.body2" Class="my-3">@_error</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="VolverAlInicio">
                Volver al inicio
            </MudButton>
        }
    </MudCard>
</div>
</RolRouteGuard>

@code {

    [SupplyParameterFromQuery(Name = "equipo")]
    public long? IdEquipo { get; set; }

    [SupplyParameterFromQuery(Name = "checklist")]
    public long? IdChecklist { get; set; }

    private bool _cargando = true;
    private string? _error;

    // Selección de equipo y checklist cuando se entra sin parámetros (sin QR).
    private bool _seleccionando;
    private EquipoDto? _equipo;
    private long? _idChecklist;
    private List<ChecklistDto> _checklists = new();

    protected override async Task OnInitializedAsync()
    {
        // La guarda corre en paralelo a esta página y no detiene su ciclo de vida. Sin sesión
        // no se llama al API: la guarda ya está redirigiendo al login.
        if (!await Sesion.TieneSesionVigenteAsync())
        {
            return;
        }

        if (!IdEquipo.HasValue || !IdChecklist.HasValue)
        {
            await MostrarSeleccionAsync();
            return;
        }

        await IniciarAsync(IdEquipo.Value, IdChecklist.Value);
    }

    private async Task MostrarSeleccionAsync()
    {
        var respuesta = await HttpClientService.GetChecklistsAsync(1, 100);
        // Un checklist sin preguntas no sirve para inspeccionar: el API lo rechazaría.
        _checklists = (respuesta?.Data?.Data ?? new List<ChecklistDto>()).Where(c => c.Activo && c.Preguntas.Count > 0).ToList();
        _seleccionando = true;
        _cargando = false;
    }

    private bool _resolviendoQr;

    /// <summary>
    /// Abre la cámara, lee la etiqueta y deja elegido el equipo; si solo hay un checklist activo,
    /// también queda elegido. Un QR regenerado o de un equipo inactivo no se acepta.
    /// </summary>
    private async Task EscanearAsync()
    {
        var dialogo = await DialogService.ShowAsync<EscanerQrDialog>("Escanear QR");
        var resultado = await dialogo.Result;
        if (resultado is not { Canceled: false, Data: string token })
        {
            return;
        }

        _resolviendoQr = true;
        var respuesta = await HttpClientService.GetEquipoByQrAsync(token);
        _resolviendoQr = false;
        if (respuesta is not { Success: true, Data: { } consulta })
        {
            Snackbar.Add(respuesta?.Message ?? "No se pudo consultar el equipo del QR", Severity.Error);
            return;
        }

        _equipo = consulta.Equipo;
        if (_checklists.Count == 1)
        {
            _idChecklist = _checklists[0].IdChecklist;
        }

        Snackbar.Add($"Equipo {consulta.Equipo.CodigoInterno} - {consulta.Equipo.NombreEquipo}", Severity.Success);
    }

    private async Task<IEnumerable<EquipoDto>> BuscarEquiposAsync(string valor, CancellationToken token)
    {
        var respuesta = await HttpClientService.GetEquiposAsync(1, 20, valor, activo: true);
        return respuesta?.Data?.Data ?? new List<EquipoDto>();
    }

    private async Task IniciarSeleccionAsync()
    {
        if (_equipo == null || _idChecklist == null)
        {
            return;
        }

        _seleccionando = false;
        _cargando = true;
        await IniciarAsync(_equipo.IdEquipo, _idChecklist.Value);
    }

    private async Task IniciarAsync(long idEquipo, long idChecklist)
    {
        var result = await HttpClientService.IniciarInspeccionAsync(new IniciarInspeccionDto
        {
            IdEquipo = idEquipo,
            IdChecklist = idChecklist
        });

        // Creada (201) o ya existente (409, que trae en Data la que estaba en curso): se continúa igual.
        if (result?.Data != null)
        {
            NavigationManager.NavigateTo($"/inspecciones/ejecutar/{result.Data.IdInspeccion}", replace: true);
            return;
        }

        // Con sesión, cualquier otra cosa es un error real. IniciarInspeccionAsync ya atrapa las
        // excepciones de red y devuelve null, así que null aquí significa "no hubo respuesta".
        _error = result?.Message
            ?? "No se pudo conectar con el servidor. Compruebe la conexión e intente de nuevo.";
        _cargando = false;
    }

    // La página no conoce el token del QR, así que no puede volver a él: el botón dice adónde va.
    private void VolverAlInicio()
    {
        NavigationManager.NavigateTo("/", replace: true);
    }
}
