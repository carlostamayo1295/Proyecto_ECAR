@page "/inspecciones"
@inject HttpClientService HttpClientService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">Inspecciones</MudText>
                <MudText Typo="Typo.body2">Registro y seguimiento de inspecciones de equipos</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                    Nueva Inspección
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>

        <MudCardContent>
            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="8">
                    <MudTextField T="string" Label="Buscar por equipo, inspector o resultado" @bind-Value="searchText" Variant="Variant.Outlined"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                        OnKeyUp="OnSearchKeyUp" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" Label="Estado" Value="estadoFiltro" Variant="Variant.Outlined" Clearable="true"
                        ValueChanged="OnEstadoChanged">
                        <MudSelectItem T="string" Value="@InspeccionEstados.EnCurso">En curso</MudSelectItem>
                        <MudSelectItem T="string" Value="@InspeccionEstados.Cerrada">Cerrada</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (inspecciones != null && inspecciones.Any())
            {
                <MudTable Items="inspecciones" Hover="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Equipo</MudTh>
                        <MudTh>Inspector</MudTh>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Resultado</MudTh>
                        <MudTh>Firma</MudTh>
                        <MudTh>Evid. / Hall.</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.IdInspeccion</MudTd>
                        <MudTd DataLabel="Equipo">@context.NombreEquipo</MudTd>
                        <MudTd DataLabel="Inspector">@context.NombreUsuario</MudTd>
                        <MudTd DataLabel="Fecha">@context.FechaInspeccion.ToLocalTime().ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Estado">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                Color="@(context.Estado == InspeccionEstados.Cerrada ? Color.Success : Color.Warning)"
                                Text="@(context.Estado == InspeccionEstados.EnCurso ? "En curso" : "Cerrada")" />
                        </MudTd>
                        <MudTd DataLabel="Resultado">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                Color="@ResultadoColor(context.Resultado)"
                                Text="@(string.IsNullOrEmpty(context.Resultado) ? "Sin registrar" : context.Resultado)" />
                        </MudTd>
                        <MudTd DataLabel="Firma">
                            <MudIcon Icon="@(context.TieneFirma ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                                Color="@(context.TieneFirma ? Color.Success : Color.Default)" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="Evid. / Hall.">@context.TotalEvidencias / @context.TotalHallazgos</MudTd>
                        <MudTd DataLabel="Acciones" Class="acciones-inspeccion">
                            @if (context.Estado == InspeccionEstados.EnCurso)
                            {
                                <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                                    StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="() => Continuar(context)" Class="action-button">
                                    Continuar
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                                    StartIcon="@Icons.Material.Filled.Assignment" OnClick="() => VerResultado(context)" Class="action-button">
                                    Ver resultado
                                </MudButton>
                            }
                            <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => OpenViewDialog(context)" Class="action-button">
                                Ver
                            </MudButton>
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialog(context)" Class="action-button">
                                Editar
                            </MudButton>
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteInspeccion(context)" Class="action-button">
                                Eliminar
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <MudPagination Class="mt-4" Count="@totalPages" Selected="@currentPage"
                    SelectedChanged="HandlePageChange" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="my-4">
                    No hay inspecciones para mostrar
                </MudAlert>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<InspeccionDto>? inspecciones;
    private string searchText = string.Empty;
    private string? estadoFiltro;
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadInspeccionesAsync();
    }

    private async Task LoadInspeccionesAsync()
    {
        isLoading = true;

        try
        {
            var result = await HttpClientService.GetInspeccionesAsync(currentPage, pageSize, searchText, estadoFiltro);

            if (result != null && result.Success && result.Data != null)
            {
                inspecciones = result.Data.Data ?? new List<InspeccionDto>();
                totalPages = result.Data.TotalPages;
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Error al cargar inspecciones", Severity.Error);
                inspecciones = new List<InspeccionDto>();
                totalPages = 1;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            inspecciones = new List<InspeccionDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            currentPage = 1;
            await LoadInspeccionesAsync();
        }
    }

    private async Task HandlePageChange(int newPage)
    {
        currentPage = newPage;
        await LoadInspeccionesAsync();
    }

    // El filtro se aplica en el servidor, antes de paginar, para que el listado y el número de
    // páginas cuenten solo las inspecciones de ese estado.
    private async Task OnEstadoChanged(string? value)
    {
        estadoFiltro = value;
        currentPage = 1;   // sin esto se quedaría en la página 7 de un listado que ahora tiene 2
        await LoadInspeccionesAsync();
    }

    /// <summary>Retoma una inspección EnCurso en el flujo de ejecución (FE-0).</summary>
    private void Continuar(InspeccionDto inspeccion)
    {
        NavigationManager.NavigateTo($"/inspecciones/ejecutar/{inspeccion.IdInspeccion}");
    }

    /// <summary>
    /// Ruta definitiva de FE-3 (docs/PLAN_FASE3_TAREAS.md §3.5 y §5): todavía no existe la
    /// página ResultadoInspeccion.razor en develop, así que hasta que FE-3 la publique esto
    /// navega a una ruta que aún no resuelve nada.
    /// </summary>
    private void VerResultado(InspeccionDto inspeccion)
    {
        NavigationManager.NavigateTo($"/inspecciones/{inspeccion.IdInspeccion}/resultado");
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<InspeccionModal>("Registrar Nueva Inspección");
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadInspeccionesAsync();
        }
    }

    private async Task OpenEditDialog(InspeccionDto inspeccion)
    {
        var parameters = new DialogParameters { ["Inspeccion"] = inspeccion };
        var dialog = await DialogService.ShowAsync<InspeccionModal>("Editar Inspección", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadInspeccionesAsync();
        }
    }

    private async Task OpenViewDialog(InspeccionDto inspeccion)
    {
        var parameters = new DialogParameters { ["Inspeccion"] = inspeccion };
        await DialogService.ShowAsync<InspeccionDetailModal>("Detalle de la Inspección", parameters);
    }

    private async Task DeleteInspeccion(InspeccionDto inspeccion)
    {
        var parameters = new DialogParameters { ["Message"] = $"¿Está seguro que desea eliminar la inspección #{inspeccion.IdInspeccion} del equipo '{inspeccion.NombreEquipo}'?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar Eliminación", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            isLoading = true;
            try
            {
                var deleteResult = await HttpClientService.DeleteInspeccionAsync(inspeccion.IdInspeccion);

                if (deleteResult != null && deleteResult.Success)
                {
                    Snackbar.Add("Inspección eliminada exitosamente", Severity.Success);
                    await LoadInspeccionesAsync();
                }
                else
                {
                    Snackbar.Add(deleteResult?.Message ?? "Error al eliminar inspección", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
    }

    private static Color ResultadoColor(string? resultado) => (resultado ?? string.Empty).ToLowerInvariant() switch
    {
        // Conforme / ConNovedad los calcula el servidor al firmar; los otros dos son de la Fase 1-2.
        "conforme" or "satisfactoria" => Color.Success,
        "connovedad" or "con novedad" => Color.Warning,
        _ => Color.Default
    };
}

<style>
.action-button {
    border-radius: 8px !important;
    font-weight: 500 !important;
    box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2) !important;
    transition: all 0.2s ease !important;
}

.action-button:hover {
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3) !important;
    transform: translateY(-1px) !important;
}

/* En el teléfono la tabla se apila y cada celda es una fila flex: sin el salto de línea los
   cuatro botones ocupan unos 400 px seguidos y ensanchan toda la página (y los modales). */
@@media (max-width: 599.98px) {
    .acciones-inspeccion {
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 4px;
    }
}
</style>
